# Copy these server-only values to /etc/human-draft.env in production.
# Never expose this file with real values to the mini program or Git.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DISH_BUCKET=dish-images
SUPABASE_ACTIVITY_BUCKET=activity-images
SUPABASE_MEDIA_COVER_BUCKET=media-covers
SUPABASE_WARDROBE_BUCKET=wardrobe-images
SUPABASE_KEY_MOMENT_BUCKET=key-moment-images
SUPABASE_AVATAR_BUCKET=user-avatars

# 图片存储。迁移完成后线上设置为 cos；改回 supabase 可快速回退。
IMAGE_STORAGE_PROVIDER=supabase
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=human-draft-images-1258101045
COS_REGION=ap-guangzhou
COS_IMAGE_DOMAIN=

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ALLOWED_OPENIDS=

# 至少 32 字节的随机服务端密钥，例如：openssl rand -base64 48
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL_MINUTES=60
SESSION_TTL_DAYS=30
MAX_UPLOAD_SIZE_MB=5

# Copy these server-only values to /etc/human-draft.env in production.
# Never expose this file with real values to the mini program or Git.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 图片统一存放在腾讯云私有 COS；Supabase 只保存业务数据和图片资产台账。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=human-draft-images-1258101045
COS_REGION=ap-guangzhou
COS_IMAGE_DOMAIN=

WECHAT_APP_ID=
WECHAT_APP_SECRET=
ADMIN_USER_IDS=

# 至少 32 字节的随机服务端密钥，例如：openssl rand -base64 48
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL_MINUTES=60
SESSION_TTL_DAYS=30
MAX_UPLOAD_SIZE_MB=5

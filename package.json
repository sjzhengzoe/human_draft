{
  "name": "human_draft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "server:start": "node --env-file-if-exists=.env server/index.mjs",
    "server:test": "NODE_ENV=test node --test server/tests/*.test.mjs",
    "menu:refresh-outside-assets": "node --env-file-if-exists=.env server/scripts/refresh-outside-menu-assets.mjs",
    "menu:upsert-drink-stand": "node --env-file-if-exists=.env server/scripts/upsert-drink-stand.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@supabase/supabase-js": "^2.110.2",
    "cos-nodejs-sdk-v5": "3.0.0",
    "fastify": "^5.10.0",
    "jose": "6.2.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "miniprogram-api-typings": "^2.8.3-1",
    "typescript": "^5.2.2"
  },
  "packageManager": "pnpm@9.10.0"
}

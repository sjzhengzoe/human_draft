<custom-navigation title="运动设置" background="#ffffff" />

<view wx:if="{{loading}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在读取设置…</view>
</view>

<view wx:else class="page page--with-navigation">
  <view class="section-title">目标设置</view>
  <view class="form-card">
    <view class="field">
      <view class="field__main">
        <view class="field__label">每日运动分钟数</view>
      </view>
      <view class="number-input">
        <input type="number" value="{{dailyMinutes}}" maxlength="3" bindinput="handleDailyInput" />
        <text>分钟</text>
      </view>
    </view>

    <view class="field">
      <view class="field__main">
        <view class="field__label">每月休息天数</view>
      </view>
      <view class="number-input">
        <input type="number" value="{{monthlyRestDays}}" maxlength="2" bindinput="handleRestInput" />
        <text>天</text>
      </view>
    </view>
  </view>

  <button
    class="save-button"
    loading="{{saving}}"
    disabled="{{saving || resetting}}"
    bindtap="handleSave"
  >保存设置</button>

  <view class="section-title section-title--data">数据管理</view>
  <view class="reset-card">
    <view class="reset-card__main">
      <view class="reset-card__title">清空全部运动历史</view>
      <view class="reset-card__desc">清空加餐、运动和休息记录，保留当前设置。</view>
    </view>
    <button
      class="reset-button"
      loading="{{resetting}}"
      disabled="{{saving || resetting}}"
      bindtap="handleReset"
    >清空</button>
  </view>

  <app-dialog
    wx:if="{{resetConfirmVisible}}"
    visible="{{true}}"
    title="清空全部运动历史"
    content="将永久清空所有加餐任务、运动记录和休息日记录。每日运动分钟数与每月休息天数会保留。"
    cancel-text="取消"
    confirm-text="确认清空"
    bindcancel="handleResetCancel"
    bindconfirm="handleResetConfirm"
  />
</view>

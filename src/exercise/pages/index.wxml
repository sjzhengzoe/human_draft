<custom-navigation title="运动养宠" />

<view wx:if="{{loading && !hasLoaded}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在看看它们…</view>
</view>

<view wx:else class="page page--with-navigation">
  <view class="pet-card">
    <view class="settings-button pet-card__settings" role="button" aria-label="运动设置" bindtap="handleSettings">
      <app-icon name="settings-2" size="24" />
    </view>
    <view class="pet-stage">
      <view class="bowl-zone">
        <image class="bowl-image" src="{{bowlImage}}" mode="aspectFit" />
        <view class="stage-label">食盆 {{bowlLabel}}</view>
      </view>

      <view class="pets-zone">
        <image class="pet-pair-image" src="{{petImage}}" mode="aspectFit" />
        <view class="stage-label">{{emotionLabel}}</view>
      </view>
    </view>
  </view>

  <view class="month-overview-card">
    <view class="mini-calendar">
      <view class="mini-calendar__toolbar">
        <view
          class="mini-calendar__arrow {{calendarCanGoPrevious ? '' : 'mini-calendar__arrow--disabled'}}"
          role="button"
          aria-label="上个月"
          bindtap="handlePreviousMonth"
        ><app-icon name="arrow-left" size="27" /></view>
        <picker
          mode="date"
          fields="month"
          value="{{calendarPickerValue}}"
          start="{{calendarPickerStart}}"
          end="{{calendarPickerEnd}}"
          disabled="{{calendarLoading || busy}}"
          bindchange="handleCalendarMonthChange"
        >
          <view class="mini-calendar__title">
            <text>{{calendarMonthLabel}}</text>
            <text class="mini-calendar__title-arrow">⌄</text>
          </view>
        </picker>
        <view
          class="mini-calendar__arrow {{calendarCanGoNext ? '' : 'mini-calendar__arrow--disabled'}}"
          role="button"
          aria-label="下个月"
          bindtap="handleNextMonth"
        ><app-icon name="arrow-right" size="27" /></view>
      </view>
      <view class="mini-calendar__weekdays">
        <text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text>
      </view>
      <view class="mini-calendar__grid">
        <view
          wx:for="{{calendarCells}}"
          wx:key="key"
          class="calendar-day calendar-day--{{item.state}} {{item.isToday ? 'calendar-day--today' : ''}} {{item.isSelected ? 'calendar-day--selected' : ''}} {{item.restUsed ? 'calendar-day--rest' : ''}}"
          role="{{item.selectable ? 'button' : ''}}"
          aria-label="{{item.ariaLabel}}"
          data-date="{{item.date}}"
          bindtap="handleCalendarDayTap"
        >
          <view wx:if="{{item.state === 'completed'}}" class="calendar-day__pet-frame">
            <image
              class="calendar-day__pet"
              src="{{calendarCatImage}}"
              mode="aspectFill"
            />
          </view>
          <view wx:elif="{{item.state === 'incomplete'}}" class="calendar-day__pet-frame">
            <image
              class="calendar-day__pet"
              src="{{calendarDogImage}}"
              mode="aspectFill"
            />
          </view>
          <text
            wx:if="{{item.state === 'future' || item.state === 'untracked'}}"
            class="calendar-day__number"
          >{{item.day}}</text>
          <text wx:if="{{item.restUsed}}" class="calendar-day__rest-mark">休</text>
        </view>
      </view>
      <view class="mini-calendar__summary">
        <view>本年未完成 {{yearIncompleteDays}} 天 · 本月未完成 {{calendarIncompleteDays}} 天</view>
        <view>可用休息额度 <text>{{restCreditBalance}}</text> 天 · 本月发放 {{currentMonthGrant}} 天</view>
      </view>
    </view>

  </view>

  <view class="balance-card">
    <view class="balance-header">
      <view class="balance-heading">{{selectedTaskTitle}}</view>
      <view wx:if="{{selectedDailyTaskState === 'pending'}}" class="task-row__remaining">
        <text class="task-row__hint">还需</text><text class="task-row__value">{{selectedPendingMinutes}}</text><text class="task-row__unit">分钟</text>
      </view>
      <view wx:elif="{{selectedDailyTaskState === 'rest'}}" class="task-row__status">已使用休息日</view>
      <view wx:else class="task-completion-summary">
        <text>共完成</text>
        <text class="task-completion-summary__value">{{selectedRecordedMinutes}}</text>
        <text>分钟</text>
        <text wx:if="{{selectedOverachievedMinutes > 0}}" class="task-completion-summary__extra">· 超额 {{selectedOverachievedMinutes}} 分钟</text>
      </view>
    </view>
  </view>

  <view class="action-section">
    <button
      class="task-button task-button--dark {{selectedCanRevokeRestDay ? 'task-button--danger' : ''}}"
      disabled="{{busy || selectedActionDisabled}}"
      loading="{{busyAction === 'complete' || busyAction === 'revoke'}}"
      bindtap="handleComplete"
    >
      <view class="task-button__title">{{completeButtonText}}</view>
    </button>
    <button
      wx:if="{{selectedShowUseRestDay}}"
      class="task-button task-button--secondary"
      disabled="{{busy || !selectedCanUseRestDay}}"
      loading="{{busyAction === 'rest'}}"
      bindtap="handleUseRestDay"
    >
      <view class="task-button__title">{{selectedUseRestDayText}}</view>
    </button>
  </view>

  <app-dialog
    wx:if="{{minutesDialogVisible}}"
    visible="{{true}}"
    placement="bottom"
    title="{{minutesDialogTitle}}"
    custom-body="{{true}}"
    custom-actions="{{true}}"
  >
    <view slot="body" class="minutes-dialog-body">
      <view class="minutes-dialog-input">
        <app-input
          custom-class="minutes-dialog-control"
          type="number"
          value="{{minutesInput}}"
          maxlength="5"
          placeholder="{{minutesDialogPlaceholder}}"
          focus
          dialog-mode
          bindinput="handleMinutesInput"
        />
        <text>分钟</text>
      </view>
    </view>
    <view slot="actions" class="minutes-dialog-actions">
      <button class="minutes-dialog-button" disabled="{{busy}}" bindtap="closeMinutesDialog">取消</button>
      <button class="minutes-dialog-button minutes-dialog-button--confirm" disabled="{{busy}}" bindtap="confirmMinutesDialog">确定</button>
    </view>
  </app-dialog>

  <app-dialog
    wx:if="{{restDialogVisible}}"
    visible="{{true}}"
    title="{{restDialogTitle}}"
    content="{{restDialogContent}}"
    cancel-text="取消"
    confirm-text="{{restDialogConfirmText}}"
    bindcancel="closeRestDialog"
    bindconfirm="confirmRestDialog"
  />
</view>

<login-required-dialog id="login-required-dialog" />

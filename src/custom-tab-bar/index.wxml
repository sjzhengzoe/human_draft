<view
  wx:if="{{!hidden}}"
  class="tabbar"
  style="background: {{themeColors.surface}}; box-shadow: 0 -10rpx 32rpx {{themeColors.shadow}};"
>
  <view
    wx:for="{{tabs}}"
    wx:key="pagePath"
    class="tabbar__item {{selected == index ? 'tabbar__item--active' : ''}}"
    style="color: {{selected == index ? themeColors.actionPrimary : themeColors.textMuted}};"
    data-index="{{index}}"
    bindtap="handleSwitch"
  >
    <view class="tabbar__icon"><app-icon name="{{selected == index ? item.icon : item.mutedIcon}}" size="30" /></view>
    <view class="tabbar__text" style="font-size: {{fontSize}};">{{item.text}}</view>
  </view>
  <view wx:if="{{masked}}" class="tabbar__mask" catchtap="noop" catchtouchmove="noop" />
</view>

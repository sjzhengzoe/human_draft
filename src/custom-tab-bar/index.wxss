.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  height: calc(98rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding: 12rpx 72rpx calc(8rpx + env(safe-area-inset-bottom));
  border-top: 0;
  background: #ffffff;
  font-family: var(--ui-font-family, "HumanDraftUI", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif);
}

.tabbar__item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  color: #888888;
}

.tabbar__item--active {
  color: #111111;
}

.tabbar__icon {
  display: flex;
  width: 38rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 7rpx;
  opacity: 0.56;
}

.tabbar__item--active .tabbar__icon {
  opacity: 1;
}

.tabbar__text {
  font-size: var(--ui-font-size-small);
  font-weight: 500;
  line-height: 1.25;
}

.tabbar__mask {
  position: absolute;
  z-index: 10;
  inset: 0;
  background: rgba(0, 0, 0, 0.48);
}

.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  height: calc(98rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding: 12rpx 72rpx calc(8rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  border-top: 0;
  border-radius: var(--ui-radius-modal, 32rpx) var(--ui-radius-modal, 32rpx) 0 0;
  background: var(--ui-color-background-surface);
  font-family: var(--ui-font-family, "HumanDraftUI", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif);
}

.tabbar__item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  color: var(--ui-color-text-muted);
}

.tabbar__item--active {
  color: var(--ui-color-text-primary);
}

.tabbar__icon {
  display: flex;
  width: 34rpx;
  height: 30rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 11rpx;
}

.tabbar__text {
  font-weight: 500;
  line-height: 1.25;
}

.tabbar__mask {
  position: absolute;
  z-index: 10;
  inset: 0;
  background: var(--ui-color-overlay);
}

<custom-navigation title="我的" show-back="{{false}}" background="{{themeColors.pageBackground}}" />

<view class="page">
  <view class="settings-content">
    <view class="profile-card">
      <image
        wx:if="{{avatarUrl}}"
        class="profile-avatar"
        src="{{avatarUrl}}"
        mode="aspectFill"
        binderror="handleAvatarError"
      />
      <image
        wx:elif="{{!loggedIn}}"
        class="profile-avatar profile-avatar--brand"
        src="/assets/brand/human-draft-logo-mark.png"
        mode="aspectFit"
        aria-label="人类草稿"
      />
      <view wx:else class="profile-avatar-fallback">{{avatarInitial}}</view>
      <view class="profile-main">
        <view class="profile-name">{{displayName}}</view>
        <view wx:if="{{isAdmin}}" class="profile-role">管理员</view>
      </view>
      <view
        wx:if="{{loggedIn}}"
        class="profile-edit-button"
        role="button"
        aria-label="修改头像和昵称"
        hover-class="profile-edit-button--hover"
        hover-stay-time="80"
        bindtap="handleEditProfileTap"
      ><app-icon name="pencil" size="27" /></view>
      <view
        wx:if="{{!loggedIn}}"
        class="profile-login-button"
        role="button"
        aria-label="登录"
        hover-class="profile-login-button--hover"
        hover-stay-time="80"
        bindtap="handleLoginTap"
      ><app-icon name="log-in" size="27" inverse="{{true}}" /><text>登录</text></view>
    </view>

    <view class="settings-section">
      <view class="settings-section__title">通用</view>
      <view class="settings-list">
        <view
          class="settings-item"
          hover-class="settings-item--hover"
          hover-stay-time="80"
          bindtap="handleModuleSettingsTap"
        >
          <view class="settings-item__label-group"><app-icon name="settings-2" size="27" /><text class="settings-item__label">首页模块显示设置</text></view>
          <view class="settings-item__right">
            <view class="settings-item__arrow"><app-icon name="chevron-right" size="27" /></view>
          </view>
        </view>
      </view>
    </view>

    <view
      wx:if="{{loggedIn}}"
      class="settings-logout-button"
      role="button"
      aria-label="退出登录"
      hover-class="settings-logout-button--hover"
      hover-stay-time="80"
      bindtap="handleLogoutTap"
    ><app-icon name="log-out" size="27" /><text>退出登录</text></view>
  </view>
</view>

<app-dialog
  visible="{{showProfileDialog && !showImageCropper}}"
  title="编辑个人资料"
  custom-body="{{true}}"
  custom-actions="{{true}}"
  bind:cancel="handleProfileDialogCancel"
>
  <view slot="body" class="profile-dialog__body">
    <view class="profile-avatar-editor">
      <image
        wx:if="{{editingAvatarUrl}}"
        class="profile-avatar-editor__image"
        src="{{editingAvatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="profile-avatar-editor__fallback">{{editingAvatarInitial}}</view>
      <view
        class="profile-avatar-editor__button"
        role="button"
        aria-label="选择并裁剪头像"
        hover-class="profile-avatar-editor__button--hover"
        hover-stay-time="80"
        bindtap="handleChooseProfileAvatar"
      ><app-icon name="pencil" size="27" inverse="{{true}}" /></view>
    </view>

    <view class="profile-dialog__field">
      <view class="profile-dialog__label">昵称</view>
      <app-input
        custom-class="profile-dialog__input"
        type="nickname"
        value="{{editingDisplayName}}"
        maxlength="40"
        placeholder="请输入昵称"
        dialog-mode="{{true}}"
        disabled="{{savingProfile}}"
        bindinput="handleDisplayNameInput"
      />
    </view>
    <view class="profile-dialog__hint">头像会裁剪为正方形并安全保存</view>
  </view>

  <view slot="actions" class="profile-dialog__actions">
    <button
      class="profile-dialog__action profile-dialog__action--cancel"
      disabled="{{savingProfile}}"
      bindtap="handleProfileDialogCancel"
    >取消</button>
    <button
      class="profile-dialog__action profile-dialog__action--save"
      loading="{{savingProfile}}"
      disabled="{{savingProfile || selectingProfileAvatar}}"
      bindtap="handleProfileSave"
    >保存</button>
  </view>
</app-dialog>

<image-cropper
  wx:if="{{showImageCropper}}"
  src="{{cropSourcePath}}"
  shape="circle"
  aspect-ratio="1"
  output-size="640"
  output-type="png"
  title="裁剪头像"
  bind:cancel="handleAvatarCropCancel"
  bind:confirm="handleAvatarCropConfirm"
  bind:error="handleAvatarCropError"
/>

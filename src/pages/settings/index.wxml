<custom-navigation title="我的" show-back="{{false}}" background="{{themeColors.pageBackground}}" />

<scroll-view
  class="page"
  scroll-y
  enhanced
  bounces="{{false}}"
  show-scrollbar="{{false}}"
>
  <view class="settings-content">
    <view class="profile-card">
      <image
        wx:if="{{avatarUrl}}"
        class="profile-avatar"
        src="{{avatarUrl}}"
        mode="aspectFill"
        binderror="handleAvatarError"
      />
      <image
        wx:elif="{{!loggedIn}}"
        class="profile-avatar profile-avatar--brand"
        src="/assets/brand/human-draft-logo-mark.png"
        mode="aspectFit"
        aria-label="人类草稿"
      />
      <view wx:else class="profile-avatar-fallback">{{avatarInitial}}</view>
      <view class="profile-main">
        <view class="profile-name">{{displayName}}</view>
        <view wx:if="{{loggedIn}}" class="profile-statuses">
          <view class="profile-role">{{accessDisplayLabel}}</view>
          <view wx:if="{{isAdmin}}" class="profile-role">管理员</view>
        </view>
      </view>
      <view
        wx:if="{{loggedIn}}"
        class="profile-edit-button"
        role="button"
        aria-label="修改头像和昵称"
        hover-class="profile-edit-button--hover"
        hover-stay-time="80"
        bindtap="handleEditProfileTap"
      ><app-icon name="pencil" size="27" /></view>
      <view
        wx:if="{{!loggedIn}}"
        class="profile-login-button"
        role="button"
        aria-label="登录"
        hover-class="profile-login-button--hover"
        hover-stay-time="80"
        bindtap="handleLoginTap"
      >登录</view>
    </view>

    <view class="public-beta-card">
      <view class="public-beta-card__title">公开测试期 · 当前免费</view>
      <view class="public-beta-card__text">功能仍在持续完善。当前不提供会员、充值或付费入口；如未来决定推出，会在启用前说明范围与规则。</view>
    </view>

    <view wx:if="{{loggedIn}}" class="settings-section settings-section--account">
      <view class="settings-section__title">账号</view>
      <view class="settings-list">
        <view class="account-id-item">
          <view class="account-id-item__content">
            <view class="account-id-item__label">UID</view>
            <text class="account-id-item__value" selectable="{{true}}">{{uid}}</text>
          </view>
          <view
            class="account-id-item__copy"
            role="button"
            aria-label="复制 UID"
            hover-class="account-id-item__copy--hover"
            hover-stay-time="80"
            bindtap="handleCopyUidTap"
          ><app-icon name="copy" size="27" /></view>
        </view>
      </view>
    </view>

    <view wx:if="{{loggedIn}}" class="settings-section">
      <view class="settings-section__title">存储空间</view>
      <view class="settings-list">
        <view class="storage-usage-item">
          <view class="storage-usage-item__header">
            <view class="storage-usage-item__label">图片空间</view>
            <view class="storage-usage-item__value {{storageUsageNearLimit ? 'storage-usage-item__value--warning' : ''}}">{{storageUsageText}}</view>
          </view>
          <view wx:if="{{storageImageCountText}}" class="storage-usage-item__count">{{storageImageCountText}}</view>
          <view class="storage-usage-item__note">达到 80 MB 后会提示空间不足；达到 100 MB 后暂停新增图片，删除图片即可释放空间。</view>
        </view>
      </view>
    </view>

    <view class="settings-section">
      <view class="settings-section__title">通用</view>
      <view class="settings-list">
        <view
          wx:if="{{isAdmin}}"
          class="settings-item"
          hover-class="settings-item--hover"
          hover-stay-time="80"
          bindtap="handleAnalyticsTap"
        >
          <view class="settings-item__label-group"><app-icon name="layout-grid" size="27" /><text class="settings-item__label">运营数据</text></view>
          <view class="settings-item__right">
            <view class="settings-item__arrow"><app-icon name="chevron-right" size="27" /></view>
          </view>
        </view>
        <view
          class="settings-item"
          hover-class="settings-item--hover"
          hover-stay-time="80"
          bindtap="handleAboutTap"
        >
          <view class="settings-item__label-group"><app-icon name="book-open" size="27" /><text class="settings-item__label">关于、隐私与服务说明</text></view>
          <view class="settings-item__right">
            <view class="settings-item__arrow"><app-icon name="chevron-right" size="27" /></view>
          </view>
        </view>
        <view
          class="settings-item"
          hover-class="settings-item--hover"
          hover-stay-time="80"
          bindtap="handleModuleSettingsTap"
        >
          <view class="settings-item__label-group"><app-icon name="settings-2" size="27" /><text class="settings-item__label">首页设置</text></view>
          <view class="settings-item__right">
            <view class="settings-item__arrow"><app-icon name="chevron-right" size="27" /></view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{isAdmin}}" class="settings-section">
      <view class="settings-section__title">管理</view>
      <view class="settings-list">
        <view
          class="settings-item"
          hover-class="settings-item--hover"
          hover-stay-time="80"
          bindtap="handleRuntimeControlsTap"
        >
          <view class="settings-item__label-group"><app-icon name="settings-2" size="27" /><text class="settings-item__label">运营控制</text></view>
          <view class="settings-item__right">
            <view class="settings-item__arrow"><app-icon name="chevron-right" size="27" /></view>
          </view>
        </view>
      </view>
    </view>

    <view
      wx:if="{{loggedIn}}"
      class="settings-logout-button"
      role="button"
      aria-label="退出登录"
      hover-class="settings-logout-button--hover"
      hover-stay-time="80"
      bindtap="handleLogoutTap"
    >退出登录</view>

    <view
      wx:if="{{loggedIn}}"
      class="settings-delete-account-button"
      role="button"
      aria-label="注销账号"
      hover-class="settings-delete-account-button--hover"
      hover-stay-time="80"
      bindtap="handleDeleteAccountTap"
    >注销账号</view>
  </view>
</scroll-view>

<app-dialog
  visible="{{deleteAccountDialogVisible}}"
  title="确认注销账号？"
  content="注销后，账号、登录会话、个人记录和私有图片将永久删除，无法恢复。请确认当前数据已不再需要。"
  cancel-text="暂不注销"
  confirm-text="永久注销"
  bind:cancel="handleDeleteAccountCancel"
  bind:confirm="handleDeleteAccountConfirm"
/>

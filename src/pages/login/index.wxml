<custom-navigation title="登录" />

<view class="page">
  <view class="login-card">
    <view class="login-mark">
      <image
        class="login-logo"
        src="/assets/brand/human-draft-logo-mark.png"
        mode="aspectFit"
        aria-label="人类草稿"
      />
    </view>
    <view class="login-title">人类草稿</view>
    <view wx:if="{{errorMessage}}" class="error-message welcome-error">{{errorMessage}}</view>
    <button
      class="primary-button"
      disabled="{{preparingProfile}}"
      bindtap="handleLoginTap"
    >{{preparingProfile ? '正在登录…' : '微信账号登录'}}</button>
    <button class="back-button" disabled="{{preparingProfile}}" bindtap="handleSkipTap">继续以游客登录</button>
  </view>
</view>

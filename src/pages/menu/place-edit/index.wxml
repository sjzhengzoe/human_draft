<custom-navigation title="店铺记录" />

<view wx:if="{{loading}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在加载店铺…</view>
</view>

<scroll-view wx:else class="edit-scroll page--fixed" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}">
  <view class="page">
    <view class="form-card">
      <view class="image-field" bindtap="handleChooseImage">
        <image wx:if="{{selectedImagePath || currentImageUrl}}" class="image-field__preview" src="{{selectedImagePath || currentImageUrl}}" mode="aspectFill" />
        <view wx:else class="image-field__empty">
          <app-icon name="image-plus" size="30" />
          <view>拍照或从相册选择店铺图片</view>
        </view>
      </view>
      <view class="field">
        <view class="field__label">店铺名</view>
        <app-input custom-class="field__input" value="{{name}}" maxlength="120" placeholder="例如：海底捞" bindinput="handleNameInput" />
      </view>
      <view class="field field--inline field--section-start">
        <view class="field__label">用餐场景</view>
        <view class="value-tag">外食</view>
      </view>
      <view class="field field--inline">
        <view class="field__label">外食分类</view>
        <picker mode="selector" range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="handleCategoryChange">
          <view class="field__picker">{{categoryNames[categoryIndex] || '请选择分类'}}<app-icon name="chevron-right" size="27" /></view>
        </picker>
      </view>
    </view>
    <view class="footer-actions">
      <button class="save-button" loading="{{saving && !savingForDish}}" disabled="{{saving || deleting}}" bindtap="handleSave">保存店铺</button>
      <button wx:if="{{!placeId}}" class="add-dish-button" loading="{{savingForDish}}" disabled="{{saving || deleting}}" bindtap="handleAddDish">保存并新增菜品</button>
      <button wx:if="{{placeId}}" class="delete-button" disabled="{{saving || deleting}}" bindtap="handleDelete"><app-icon name="trash-2-danger" size="24" />删除店铺</button>
    </view>
  </view>
</scroll-view>

<app-dialog visible="{{showDeleteDialog}}" title="删除店铺" content="店铺和店内菜品将从菜单库删除；本周菜单中已有的记录会保留当时的名称和图片。" confirmText="删除" bind:cancel="handleDeleteCancel" bind:confirm="handleDeleteConfirm" />

<image-cropper wx:if="{{showImageCropper}}" src="{{cropSourcePath}}" shape="square" aspect-ratio="1" title="裁剪为 1:1 图片" bind:cancel="handleImageCropCancel" bind:confirm="handleImageCropConfirm" bind:error="handleImageCropError" />

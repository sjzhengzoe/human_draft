<view wx:if="{{loading && !hasLoaded}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在加载菜单…</view>
</view>

<view wx:else class="page">
  <scroll-view class="side-tabs" scroll-y enhanced show-scrollbar="{{false}}">
    <view
      class="side-tab {{activeFilter === 'all' ? 'side-tab--active' : ''}}"
      data-filter="all"
      bindtap="handleFilterTap"
    >全部</view>
    <view class="side-tabs__divider" />
    <view
      class="side-tab side-tab--section {{activeFilter === 'outside' ? 'side-tab--active' : ''}}"
      data-filter="outside"
      bindtap="handleFilterTap"
    >外食</view>
    <view
      wx:for="{{outsideCategories}}"
      wx:key="id"
      class="side-tab {{activeFilter === 'outside:' + item.id ? 'side-tab--active' : ''}}"
      data-filter="outside:{{item.id}}"
      bindtap="handleFilterTap"
    >{{item.name}}</view>
    <view class="side-tabs__divider" />
    <view
      class="side-tab side-tab--section {{activeFilter === 'home' ? 'side-tab--active' : ''}}"
      data-filter="home"
      bindtap="handleFilterTap"
    >在家</view>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="side-tab {{activeFilter === 'home:' + item.id ? 'side-tab--active' : ''}}"
      data-filter="home:{{item.id}}"
      bindtap="handleFilterTap"
    >{{item.name}}</view>
  </scroll-view>

  <view class="content">
    <view class="app-overview menu-overview">
      <view class="app-overview__topline">
        <view class="app-overview__title-group">
          <view class="app-overview__title">饮食清单</view>
        </view>
        <button wx:if="{{canWrite}}" class="app-overview__action" bindtap="handleAddTap"><app-icon name="plus-white" size="22" /><text>新增</text></button>
      </view>
      <view class="app-overview__stats">
        <view class="app-overview__stat">
          <view class="app-overview__value">{{dishes.length}}</view>
          <view class="app-overview__label">当前选项</view>
        </view>
        <view class="app-overview__stat">
          <view class="app-overview__value">{{categories.length}}</view>
          <view class="app-overview__label">居家分类</view>
        </view>
      </view>
    </view>

    <view class="menu-toolbar">
      <view class="menu-toolbar__action menu-toolbar__action--featured" bindtap="handleDayPlanTap">
        <app-icon name="layout-grid" size="22" />
        <text>安排三餐</text>
      </view>
      <view class="menu-toolbar__action" bindtap="handlePrintTap">
        <app-icon name="printer" size="22" />
        <text>打印</text>
      </view>
      <view
        wx:if="{{canReorder}}"
        class="menu-toolbar__action {{sortEditing ? 'menu-toolbar__action--active' : ''}}"
        bindtap="handleSortEditingToggle"
      >
        <app-icon name="settings-2" size="22" />
        <text>{{sortEditing ? '完成排序' : '编辑排序'}}</text>
      </view>
    </view>

    <scroll-view class="list-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{errorMessage}}" class="state-block">
      <view>{{errorMessage}}</view>
      <button class="retry-button" bindtap="handleRetry">重试</button>
    </view>
    <view wx:elif="{{dishes.length === 0}}" class="state-block">暂无菜品</view>

    <view wx:else class="dish-list">
      <view
        wx:for="{{dishes}}"
        wx:key="id"
        class="dish-card"
        data-id="{{item.id}}"
        data-index="{{index}}"
        bindtap="handleDishTap"
      >
        <view class="dish-card__image-wrap">
          <image wx:if="{{item.thumbnail_url || item.image_url}}" class="dish-card__image" src="{{item.thumbnail_url || item.image_url}}" mode="aspectFit" lazy-load />
          <view wx:else class="dish-card__image-empty">暂无图片</view>
        </view>
        <view class="dish-card__body">
          <view class="dish-card__title-row">
            <view class="dish-card__name">{{item.name}}</view>
            <view class="dish-card__type">{{item.recordTypeLabel}}</view>
          </view>
          <view class="dish-card__category">
            {{item.record_type === 'outside'
              ? (item.outside_category && item.outside_category.name ? item.outside_category.name : '未分类')
              : (item.category && item.category.name ? item.category.name : '未分类')}}
          </view>
          <view wx:if="{{item.mealPeriodTags.length}}" class="dish-card__meals">
            <view
              wx:for="{{item.mealPeriodTags}}"
              wx:key="key"
              wx:for-item="mealTag"
              class="dish-card__meal"
            >{{mealTag.label}}</view>
          </view>
          <view wx:if="{{canReorder && sortEditing}}" class="sort-actions">
            <view class="sort-action {{index === 0 ? 'sort-action--disabled' : ''}}" data-index="{{index}}" data-direction="-1" catchtap="handleMove"><app-icon name="arrow-up" size="24" /></view>
            <view class="sort-action {{index === dishes.length - 1 ? 'sort-action--disabled' : ''}}" data-index="{{index}}" data-direction="1" catchtap="handleMove"><app-icon name="arrow-down" size="24" /></view>
          </view>
        </view>
      </view>
    </view>
    </scroll-view>
  </view>
  <operation-loading visible="{{ordering}}" text="正在保存排序…" />
</view>

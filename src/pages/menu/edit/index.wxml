<custom-navigation title="菜单记录" />

<view wx:if="{{loading}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在加载菜品…</view>
</view>

<scroll-view
  wx:else
  class="edit-scroll page--fixed"
  scroll-y
  enhanced
  bounces="{{false}}"
  show-scrollbar="{{false}}"
>
  <view class="page">
    <view class="form-card">
      <view class="image-field" bindtap="handleChooseImage">
        <image
          wx:if="{{selectedImagePath || currentImageUrl}}"
          class="image-field__preview"
          src="{{selectedImagePath || currentImageUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="image-field__empty">
          <view class="image-field__plus"><app-icon name="image-plus" size="30" /></view>
          <view>拍照或从相册选择菜品图片</view>
          <view wx:if="{{recordType === 'outside'}}" class="image-field__optional">外食菜品可暂不添加</view>
        </view>
      </view>

      <view class="field field--inline field--name">
        <view class="field__label">菜品名称<text class="field__required">*</text></view>
        <app-input
          custom-class="field__input"
          value="{{name}}"
          maxlength="120"
          placeholder="例如：番茄炒鸡蛋"
          bindinput="handleNameInput"
        />
      </view>

      <view class="field field--inline field--introduction">
        <view class="field__label">菜品介绍</view>
        <app-input
          custom-class="field__input"
          value="{{introduction}}"
          maxlength="1000"
          confirm-type="done"
          placeholder="简单介绍这道菜"
          bindinput="handleIntroductionInput"
        />
      </view>

      <view class="field field--inline field--section-start">
        <view class="field__label">用餐场景<text class="field__required">*</text></view>
        <view class="field__choices">
          <view class="choice-option choice-option--selected">{{recordType === 'outside' ? '外食' : '在家'}}</view>
        </view>
      </view>

      <view wx:if="{{recordType === 'outside'}}" class="field field--inline">
        <view class="field__label">所属店铺<text class="field__required">*</text></view>
        <view class="field__choices">
          <view class="choice-option choice-option--selected">{{placeName}}</view>
        </view>
      </view>

      <view wx:if="{{recordType === 'home'}}" class="field field--inline">
        <view class="field__label">菜品分类<text class="field__required">*</text></view>
        <view class="meal-period-options" role="radiogroup" aria-label="菜品分类">
          <view
            wx:for="{{categoryNames}}"
            wx:key="*this"
            class="meal-period-option {{index === categoryIndex ? 'meal-period-option--selected' : ''}}"
            data-index="{{index}}"
            bindtap="handleCategoryTap"
            role="radio"
            aria-checked="{{index === categoryIndex}}"
          >
            <view class="meal-period-option__label">{{item}}</view>
          </view>
        </view>
      </view>

      <view class="field field--inline meal-period-field">
        <view class="field__label">适用餐次<text class="field__required">*</text></view>
        <view class="meal-period-options">
          <view
            wx:for="{{mealOptions}}"
            wx:key="key"
            class="meal-period-option {{item.selected ? 'meal-period-option--selected' : ''}}"
            data-key="{{item.key}}"
            bindtap="handleMealPeriodTap"
            role="button"
            aria-label="{{item.label}}{{item.selected ? '，已选择' : '，未选择'}}"
          >
            <view class="meal-period-option__label">{{item.label}}</view>
          </view>
        </view>
      </view>

      <view class="field field--inline field--section-start">
        <view class="field__label">主要食材</view>
        <view class="item-field__content">
          <view wx:if="{{mainIngredients.length}}" class="item-list">
            <view wx:for="{{mainIngredients}}" wx:key="*this" class="item-chip">
              <text class="item-chip__label">{{item}}</text>
              <view class="item-chip__remove" data-index="{{index}}" catchtap="handleRemoveMainIngredient" role="button" aria-label="删除{{item}}">
                <app-icon name="x-muted" size="24" />
              </view>
            </view>
          </view>
          <view class="item-entry">
            <app-input
              custom-class="item-entry__input"
              value="{{mainIngredientInput}}"
              maxlength="80"
              confirm-type="done"
              placeholder="输入食材，例如：虾仁"
              bindconfirm="handleAddMainIngredient"
              bindinput="handleMainIngredientsInput"
            />
            <button class="item-entry__add" bindtap="handleAddMainIngredient">添加</button>
          </view>
        </view>
      </view>

      <view class="field field--inline field--section-start">
        <view class="field__label">烹饪类型</view>
        <view class="field__choices">
          <view
            wx:for="{{cookingMethodOptions}}"
            wx:key="value"
            class="choice-option {{item.selected ? 'choice-option--selected' : ''}}"
            data-value="{{item.value}}"
            bindtap="handleCookingMethodTap"
            role="button"
            aria-label="{{item.value}}{{item.selected ? '，已选择' : '，未选择'}}"
          >{{item.value}}</view>
        </view>
      </view>

      <view class="field field--inline field--section-start">
        <view class="field__label">口味特点</view>
        <view class="field__choices">
          <view
            wx:for="{{tasteOptions}}"
            wx:key="value"
            class="choice-option {{item.selected ? 'choice-option--selected' : ''}}"
            data-value="{{item.value}}"
            bindtap="handleTasteTap"
            role="button"
            aria-label="{{item.value}}{{item.selected ? '，已选择' : '，未选择'}}"
          >{{item.value}}</view>
        </view>
      </view>

      <view class="field field--inline">
        <view class="field__label">衍生菜系</view>
        <view class="item-field__content">
          <view wx:if="{{flavorOptions.length}}" class="item-list">
            <view wx:for="{{flavorOptions}}" wx:key="*this" class="item-chip">
              <text class="item-chip__label">{{item}}</text>
              <view class="item-chip__remove" data-index="{{index}}" catchtap="handleRemoveFlavorOption" role="button" aria-label="删除{{item}}">
                <app-icon name="x-muted" size="24" />
              </view>
            </view>
          </view>
          <view class="item-entry">
            <app-input
              custom-class="item-entry__input"
              value="{{flavorOptionInput}}"
              maxlength="80"
              confirm-type="done"
              placeholder="输入衍生菜，例如：紫苏炒虾"
              bindconfirm="handleAddFlavorOption"
              bindinput="handleFlavorOptionsInput"
            />
            <button class="item-entry__add" bindtap="handleAddFlavorOption">添加</button>
          </view>
        </view>
      </view>
    </view>

    <view class="footer-actions">
      <button class="save-button" loading="{{saving}}" disabled="{{saving || deleting || selectingImage}}" bindtap="handleSave">
        保存菜品
      </button>
      <button wx:if="{{dishId}}" class="delete-button" loading="{{deleting}}" disabled="{{saving || deleting || selectingImage}}" bindtap="handleDelete">
        <app-icon name="trash-2-danger" size="24" /><text>删除菜品</text>
      </button>
    </view>
  </view>
</scroll-view>

<app-dialog
  visible="{{showDeleteDialog}}"
  title="删除菜品"
  content="菜品将从菜单库删除；本周菜单中已有的记录会保留当时的名称和图片。"
  confirmText="删除"
  bind:cancel="handleDeleteCancel"
  bind:confirm="handleDeleteConfirm"
/>

<image-cropper
  wx:if="{{showImageCropper}}"
  src="{{cropSourcePath}}"
  shape="rectangle"
  aspect-ratio="1.333333"
  title="裁剪为 4:3 图片"
  bind:cancel="handleImageCropCancel"
  bind:confirm="handleImageCropConfirm"
  bind:error="handleImageCropError"
/>

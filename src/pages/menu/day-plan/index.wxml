<view class="menu-week-planner">
<view class="planner-page">
  <view class="planner-header">
    <view class="planner-toolbar planner-toolbar--spread">
      <view class="time-tabs" role="tablist" aria-label="查看范围">
        <view wx:for="{{['day', 'week']}}" wx:key="*this" class="time-tab {{activeMode === item ? 'time-tab--active' : ''}}" data-mode="{{item}}" bindtap="handleModeTap">{{item === 'day' ? '日' : '周'}}</view>
      </view>
      <view class="planner-toolbar__actions">
        <button wx:if="{{activeMode === 'day'}}" class="random-action random-action--primary" loading="{{randomizing}}" bindtap="handleRandomize">随机点菜</button>
        <button class="ranking-button" bindtap="handleRanking">排行榜</button>
      </view>
    </view>
    <view class="week-rail" aria-label="{{activeMode === 'week' ? '切换周次' : '切换日期'}}">
      <view wx:for="{{activeMode === 'week' ? weekRailItems : dayRailItems}}" wx:key="key" class="week-rail__item {{item.selected ? 'week-rail__item--selected' : ''}}" role="button" aria-label="{{item.ariaLabel}}" data-direction="{{item.direction}}" bindtap="handlePeriodMove">
        <view class="week-rail__visual">
          <view class="week-rail__label">{{item.label}}</view>
          <view class="week-rail__range">{{item.rangeLabel}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeMode === 'week' && hasLoaded && !errorMessage}}" class="week-table">
    <view class="week-matrix week-matrix--header">
      <view class="week-matrix__header">
        <view class="week-matrix__corner" />
        <view wx:for="{{['早餐', '午餐', '下午茶', '晚餐']}}" wx:key="*this" class="week-matrix__heading">{{item}}</view>
      </view>
    </view>
    <scroll-view class="week-table__content" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}">
      <view class="week-table__inner">
        <view class="week-matrix week-matrix--body">
          <view wx:for="{{weekDays}}" wx:key="date" wx:for-item="day" wx:for-index="dayIndex" class="week-matrix__row {{dayIndex === weekDays.length - 1 ? 'week-matrix__row--last' : ''}}">
            <view class="week-matrix__day {{day.isToday ? 'week-matrix__day--today' : ''}}">
              <view class="week-matrix__day-label">{{day.dayLabel}}</view>
              <view class="week-matrix__date">{{day.dateLabel}}</view>
            </view>
            <view wx:for="{{day.meals}}" wx:key="key" wx:for-item="meal" class="week-matrix__cell {{meal.count ? 'week-matrix__cell--filled' : 'week-matrix__cell--empty'}}" role="button" aria-label="{{meal.count ? day.dayLabel + meal.label + '，已选择' + meal.count + '项' : '安排' + day.dayLabel + meal.label}}" data-date="{{day.date}}" data-period="{{meal.key}}" bindtap="handleMealEdit">
              <block wx:if="{{meal.count}}">
                <view wx:for="{{meal.items}}" wx:key="key" wx:for-item="entry" class="week-matrix__item">
                  <image wx:if="{{entry.imageUrl}}" class="week-matrix__thumbnail" src="{{entry.imageUrl}}" mode="aspectFit" lazy-load />
                  <view wx:else class="week-matrix__thumbnail week-matrix__thumbnail--fallback">{{entry.fallbackText}}</view>
                  <view class="week-matrix__item-name">{{entry.name}}</view>
                </view>
              </block>
              <app-icon wx:else name="plus" size="24" />
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <scroll-view wx:else class="planner-content" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}">
    <view class="planner-content__inner">

    <view wx:if="{{loading && !hasLoaded}}" class="planner-initial-loading content-loading">
      <view class="content-loading__spinner" />
      <view class="content-loading__text">正在准备菜单…</view>
    </view>

    <view wx:elif="{{errorMessage}}" class="state-card">
      <view class="state-card__title">暂时没能打开菜单</view>
      <view class="state-card__description">{{errorMessage}}</view>
      <button class="retry-button" bindtap="handleRetry">重试</button>
    </view>

    <block wx:elif="{{activeMode === 'day'}}">
      <view class="meal-list">
        <view wx:for="{{dayMeals}}" wx:key="key" wx:for-item="meal" wx:for-index="mealIndex" class="meal-section meal-section--{{meal.key}} {{mealIndex === dayMeals.length - 1 ? 'meal-section--last' : ''}}">
          <view class="meal-section__header">
            <view class="meal-section__title">{{meal.label}}</view>
            <view class="meal-section__count">{{meal.items.length ? meal.items.length + ' 道' : '未安排'}}</view>
          </view>

          <scroll-view class="meal-grid-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="meal-grid">
              <view wx:for="{{meal.items}}" wx:key="key" wx:for-item="planItem" wx:for-index="itemIndex" class="meal-slot">
                <view class="meal-slot__image-wrap">
                  <image wx:if="{{planItem.item.image_url}}" class="meal-slot__image" src="{{planItem.item.image_url}}" mode="aspectFit" fade-in="{{false}}" lazy-load />
                  <view wx:else class="meal-slot__placeholder"><view>暂无图片</view></view>
                  <view class="meal-slot__type">{{planItem.item.record_type === 'outside' ? '店铺' : '菜品'}}</view>
                </view>
                <view class="meal-slot__remove" role="button" aria-label="移除{{planItem.item.name}}" data-meal-index="{{mealIndex}}" data-item-index="{{itemIndex}}" catchtap="handleRemoveMealItem">
                  <view class="meal-slot__remove-visual"><app-icon name="x-muted" size="18" /></view>
                </view>
                <view class="meal-slot__name">{{planItem.item.name}}</view>
              </view>
              <view class="meal-slot meal-slot--add" role="button" aria-label="添加{{meal.label}}菜品" data-period="{{meal.key}}" data-date="{{selectedDate}}" bindtap="handleMealEdit">
                <app-icon name="plus" size="27" />
                <view>选择菜品</view>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
    </block>

    </view>
  </scroll-view>
</view>

<login-required-dialog id="login-required-dialog" />
</view>

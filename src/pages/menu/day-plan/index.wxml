<view class="planner-shell">
  <view class="planner-navigation">
    <custom-navigation title="本周菜单" />
  </view>

  <view wx:if="{{loading && !hasLoaded}}" class="fullscreen-loading">
    <view class="fullscreen-loading__spinner" />
    <view class="fullscreen-loading__text">正在准备菜单…</view>
  </view>

<view wx:else class="planner-page">
  <view class="planner-header">
    <view class="planner-toolbar">
      <view class="time-tabs" role="tablist" aria-label="查看范围">
        <view wx:for="{{['day', 'week', 'month', 'year']}}" wx:key="*this" class="time-tab {{activeMode === item ? 'time-tab--active' : ''}}" data-mode="{{item}}" bindtap="handleModeTap">{{item === 'day' ? '日' : item === 'week' ? '周' : item === 'month' ? '月' : '年'}}</view>
      </view>
      <button class="ranking-button" bindtap="handleRanking">排行榜</button>
    </view>

    <view class="period-bar">
      <view class="period-arrow" role="button" aria-label="上一个时间范围" data-direction="-1" bindtap="handlePeriodMove"><app-icon name="arrow-left" size="27" /></view>
      <view class="period-copy" bindtap="handleToday">
        <view class="period-label">{{periodLabel}}</view>
        <view class="period-today">点击回到当前日期</view>
      </view>
      <view class="period-arrow" role="button" aria-label="下一个时间范围" data-direction="1" bindtap="handlePeriodMove"><app-icon name="arrow-right" size="27" /></view>
    </view>
  </view>

  <scroll-view class="planner-content" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}">
    <view class="planner-content__inner">

    <view wx:if="{{errorMessage}}" class="state-card">
      <view class="state-card__title">暂时没能打开菜单</view>
      <view class="state-card__description">{{errorMessage}}</view>
      <button class="retry-button" bindtap="handleRetry">重试</button>
    </view>

    <block wx:elif="{{activeMode === 'day'}}">
      <view class="random-header">
        <view>
          <view class="random-header__title">今天吃什么</view>
          <view class="random-header__hint">点选菜品可锁定，随机时会保留</view>
        </view>
        <view class="random-actions">
          <button class="random-action random-action--secondary" bindtap="handleResetLocks">全部解锁</button>
          <button class="random-action random-action--primary" loading="{{saving}}" bindtap="handleRandomize">随机菜单</button>
        </view>
      </view>

      <view class="meal-list">
        <view wx:for="{{dayMeals}}" wx:key="key" wx:for-item="meal" wx:for-index="mealIndex" class="meal-section meal-section--{{meal.key}}">
          <view class="meal-section__header">
            <view class="meal-section__copy" data-period="{{meal.key}}" data-date="{{selectedDate}}" bindtap="handleMealEdit">
              <view class="meal-section__title">{{meal.label}}</view>
              <view class="meal-section__english">{{meal.englishLabel}}</view>
            </view>
            <view class="meal-section__tools">
              <view class="meal-tool" role="button" aria-label="选择{{meal.label}}" data-period="{{meal.key}}" data-date="{{selectedDate}}" bindtap="handleMealEdit"><app-icon name="pencil" size="24" /></view>
              <view class="meal-tool" role="button" aria-label="增加一个档位" data-meal-index="{{mealIndex}}" bindtap="handleAddSlot"><app-icon name="plus" size="24" /></view>
              <view class="meal-tool {{meal.slotCount <= 1 ? 'meal-tool--disabled' : ''}}" role="button" aria-label="删除最后一个档位" data-meal-index="{{mealIndex}}" bindtap="handleRemoveSlotRequest"><app-icon name="x-muted" size="24" /></view>
            </view>
          </view>

          <scroll-view class="meal-grid-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="meal-grid">
              <view wx:for="{{meal.slots}}" wx:key="key" wx:for-item="slot" wx:for-index="slotIndex" class="meal-slot {{slot.locked ? 'meal-slot--locked' : ''}} {{!slot.item ? 'meal-slot--empty' : ''}}" data-meal-index="{{mealIndex}}" data-slot-index="{{slotIndex}}" bindtap="handleSlotTap">
                <view class="meal-slot__image-wrap">
                  <image wx:if="{{slot.item && slot.item.image_url}}" class="meal-slot__image" src="{{slot.item.image_url}}" mode="aspectFill" lazy-load />
                  <view wx:else class="meal-slot__placeholder"><app-icon name="plus" size="27" /><view>{{slot.item ? '暂无图片' : '选择菜品'}}</view></view>
                  <view wx:if="{{slot.item}}" class="meal-slot__type">{{slot.item.record_type === 'outside' ? '店铺' : '菜品'}}</view>
                  <view wx:if="{{slot.locked}}" class="meal-slot__lock">已锁</view>
                </view>
                <view class="meal-slot__name">{{slot.item ? slot.item.name : '空档位'}}</view>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
    </block>

    <view wx:elif="{{activeMode === 'week'}}" class="week-matrix">
      <view class="week-matrix__header">
        <view class="week-matrix__corner" />
        <view wx:for="{{['早餐', '午餐', '下午茶', '晚餐']}}" wx:key="*this" class="week-matrix__heading">{{item}}</view>
      </view>
      <view wx:for="{{weekDays}}" wx:key="date" wx:for-item="day" wx:for-index="dayIndex" class="week-matrix__row {{dayIndex === weekDays.length - 1 ? 'week-matrix__row--last' : ''}}">
        <view class="week-matrix__day {{day.isToday ? 'week-matrix__day--today' : ''}}">
          <view class="week-matrix__day-label">{{day.dayLabel}}</view>
          <view class="week-matrix__date">{{day.dateLabel}}</view>
        </view>
        <view wx:for="{{day.meals}}" wx:key="key" wx:for-item="meal" class="week-matrix__cell {{meal.count ? 'week-matrix__cell--filled' : 'week-matrix__cell--empty'}}" role="button" aria-label="{{meal.count ? day.dayLabel + meal.label + '，已选择' + meal.count + '项' : '安排' + day.dayLabel + meal.label}}" data-date="{{day.date}}" data-period="{{meal.key}}" bindtap="handleMealEdit">
          <block wx:if="{{meal.count}}">
            <view wx:for="{{meal.items}}" wx:key="key" wx:for-item="entry" class="week-matrix__item">
              <image wx:if="{{entry.imageUrl}}" class="week-matrix__thumbnail" src="{{entry.imageUrl}}" mode="aspectFill" lazy-load />
              <view wx:else class="week-matrix__thumbnail week-matrix__thumbnail--fallback">{{entry.fallbackText}}</view>
              <view class="week-matrix__item-name">{{entry.name}}</view>
            </view>
          </block>
          <app-icon wx:else name="plus" size="24" />
        </view>
      </view>
    </view>

    <view wx:elif="{{activeMode === 'month'}}" class="month-panel">
      <view class="month-weekdays"><view wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</view></view>
      <view class="month-grid">
        <view wx:for="{{monthCells}}" wx:key="key" class="month-cell {{item.inMonth ? '' : 'month-cell--muted'}} {{item.isToday ? 'month-cell--today' : ''}}" data-date="{{item.date}}" bindtap="handleMonthDayTap">
          <view class="month-cell__day">{{item.day}}</view>
          <view wx:if="{{item.count}}" class="month-cell__count">{{item.count}}项</view>
        </view>
      </view>
      <view class="view-hint">点击日期查看并编辑当天菜单</view>
    </view>

    <view wx:else class="year-grid">
      <view wx:for="{{yearMonths}}" wx:key="month" class="year-card" data-month="{{item.month}}" bindtap="handleYearMonthTap">
        <view class="year-card__month">{{item.label}}</view>
        <view class="year-card__count">{{item.count}} 项</view>
        <view class="year-card__meta">记录 {{item.mealCount}} 餐</view>
      </view>
    </view>
    </view>
  </scroll-view>
</view>
</view>

<app-dialog visible="{{showRemoveDialog}}" title="删除一个档位" content="最后一个档位中的菜品也会一起移除。" confirmText="删除" bind:cancel="handleRemoveCancel" bind:confirm="handleRemoveConfirm" />
<operation-loading visible="{{saving}}" text="正在保存菜单…" />

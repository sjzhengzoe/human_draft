<custom-navigation
  title="管理{{activeType}}活动"
  custom-back="{{true}}"
  bind:back="handleBack"
/>

<view wx:if="{{loading && !hasLoaded}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在读取活动…</view>
</view>

<view wx:else class="page page--with-navigation">
  <scroll-view class="manager-scroll" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}">
    <view wx:if="{{items.length === 0}}" class="manager-empty">还没有活动</view>
    <view wx:else class="manager-list">
      <view wx:for="{{items}}" wx:key="id" class="manager-item">
        <view class="manager-item__name">{{item.name}}</view>
        <view class="manager-item__actions">
          <view
            class="manager-icon-button {{index === 0 ? 'manager-icon-button--disabled' : ''}}"
            role="button"
            aria-label="向上移动{{item.name}}"
            data-index="{{index}}"
            data-direction="-1"
            bindtap="handleManagerMove"
          ><app-icon name="arrow-up" size="24" /></view>
          <view
            class="manager-icon-button {{index === items.length - 1 ? 'manager-icon-button--disabled' : ''}}"
            role="button"
            aria-label="向下移动{{item.name}}"
            data-index="{{index}}"
            data-direction="1"
            bindtap="handleManagerMove"
          ><app-icon name="arrow-down" size="24" /></view>
          <view
            class="manager-icon-button"
            role="button"
            aria-label="编辑{{item.name}}"
            data-id="{{item.id}}"
            bindtap="handleManagerEdit"
          ><app-icon name="pencil" size="24" /></view>
          <view
            class="manager-icon-button"
            role="button"
            aria-label="删除{{item.name}}"
            data-id="{{item.id}}"
            bindtap="handleDeleteRequest"
          ><app-icon name="trash-2-danger" size="24" /></view>
        </view>
      </view>
    </view>
    <view class="manager-safe-area" />
  </scroll-view>

  <operation-loading visible="{{ordering}}" text="正在保存排序…" />

  <app-dialog
    visible="{{showDeleteDialog}}"
    title="删除活动"
    content="确定删除“{{pendingDeleteName}}”吗？封面也会从云端移除，删除后无法恢复。"
    confirm-text="删除"
    bind:cancel="handleDeleteCancel"
    bind:confirm="handleDeleteConfirm"
  />
</view>

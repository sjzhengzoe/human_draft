<custom-navigation title="影视分类" />

<view wx:if="{{loading && !hasLoaded}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在加载分类…</view>
</view>

<view wx:else class="page page--with-navigation">
  <view class="overview">
    <view class="overview__topline">
      <view class="overview__title">管理影视分类</view>
      <button class="overview__add" bindtap="handleAdd"><app-icon name="plus-white" size="24" /><text>新增</text></button>
    </view>
    <view class="overview__stats">
      <view class="overview-stat">
        <view class="overview-stat__value">{{categories.length}}</view>
        <view class="overview-stat__label">分类</view>
      </view>
    </view>
  </view>

  <view wx:if="{{categories.length > 1}}" class="sort-toolbar">
    <view class="sort-toolbar__action {{sortEditing ? 'sort-toolbar__action--active' : ''}}" bindtap="handleSortEditingToggle">
      <app-icon name="settings-2" size="24" />
      <text>{{sortEditing ? '完成排序' : '编辑排序'}}</text>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="state">
    <view>{{errorMessage}}</view>
    <button class="retry-button" bindtap="handleRetry">重试</button>
  </view>
  <view wx:elif="{{categories.length === 0}}" class="state">还没有分类</view>
  <view wx:else class="category-list">
    <view wx:for="{{categories}}" wx:key="id" style="{{dragSortPreviewStyles[index]}}" class="category-card js-category-sort-item {{draggingSortKey === item.id ? 'category-card--dragging' : ''}}" data-id="{{item.id}}" bindtap="handleEdit" role="button" aria-label="编辑{{item.name}}分类">
      <view class="category-card__main">
        <view class="category-card__name">{{item.name}}</view>
        <view class="category-card__fields">点击修改分类名称</view>
      </view>
      <view wx:if="{{sortEditing}}" class="category-card__sort">
        <view class="sort-control" role="button" aria-label="长按拖拽调整{{item.name}}分类顺序" data-index="{{index}}" catchlongpress="handleSortDragLongPress" catchtouchmove="handleSortDragMove" catchtouchend="handleSortDragEnd" catchtouchcancel="handleSortDragEnd"><app-icon name="drag-handle" size="27" /></view>
      </view>
      <view class="category-card__arrow"><app-icon name="pencil" size="24" /></view>
    </view>
  </view>
  <operation-loading visible="{{moving}}" text="正在保存排序…" />
  <sort-drag-ghost visible="{{draggingSortKey !== ''}}" title="{{dragSortGhostTitle}}" meta="{{dragSortGhostMeta}}" custom-style="{{dragSortGhostStyle}}" />

  <app-dialog
    wx:if="{{editorVisible}}"
    visible="{{true}}"
    placement="bottom"
    title="{{editorId ? '编辑影视分类' : '新增影视分类'}}"
    custom-body="{{true}}"
    custom-actions="{{true}}"
    bindcancel="closeEditor"
  >
    <view slot="body" class="category-editor">
      <app-input
        custom-class="category-editor__input"
        value="{{editorName}}"
        maxlength="40"
        placeholder="例如：纪录片、播客"
        focus
        dialog-mode
        bindinput="handleEditorInput"
        bindconfirm="saveEditor"
      />
    </view>
    <view slot="actions" class="category-editor__actions">
      <view wx:if="{{editorId}}" class="category-editor__delete" role="button" bindtap="handleDeleteRequest">
        <app-icon name="trash-2-danger" size="24" />
        <text>删除分类</text>
      </view>
      <view class="category-editor__main-actions">
        <button class="category-editor__button" disabled="{{saving}}" bindtap="closeEditor">取消</button>
        <button class="category-editor__button category-editor__button--primary" loading="{{saving}}" disabled="{{saving || !editorCanSave}}" bindtap="saveEditor">保存</button>
      </view>
    </view>
  </app-dialog>

  <app-dialog
    wx:if="{{deleteConfirmVisible}}"
    visible="{{true}}"
    title="删除影视分类"
    content="只有分类下没有影视条目时才能删除“{{editorName}}”。"
    cancel-text="取消"
    confirm-text="删除"
    bindcancel="handleDeleteCancel"
    bindconfirm="handleDeleteConfirm"
  />
</view>

<login-required-dialog id="login-required-dialog" />

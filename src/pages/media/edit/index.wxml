<custom-navigation title="新增影视" compact-title="{{true}}" />

<view wx:if="{{loading}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在加载影视资料…</view>
</view>

<view wx:else class="page page--with-navigation">
  <view class="form-card">
    <view class="field">
      <view class="field-label">名称</view>
      <app-input custom-class="field-input" font-size="20rpx" value="{{title}}" maxlength="120" placeholder="输入影视剧、动漫或小说名称" bindinput="handleTitleInput" />
    </view>
    <view class="field">
      <view class="field-label">分类</view>
      <picker mode="selector" range="{{mediaTypes}}" value="{{mediaTypeIndex}}" bindchange="handleTypeChange">
        <view class="picker-value"><text>{{mediaTypes[mediaTypeIndex]}}</text><app-icon name="chevron-right" size="28" /></view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">状态</view>
      <view class="status-options">
        <view class="status-option {{watchStatus === 'planned' ? 'status-option--active' : ''}}" data-status="planned" bindtap="handleStatusTap">{{isAudio ? '想听' : '想看'}}</view>
        <view class="status-option {{watchStatus === 'in_progress' ? 'status-option--active' : ''}}" data-status="in_progress" bindtap="handleStatusTap">{{isAudio ? '在听' : '在看'}}</view>
        <view class="status-option {{watchStatus === 'completed' ? 'status-option--active' : ''}}" data-status="completed" bindtap="handleStatusTap">{{isAudio ? '听过' : '看过'}}</view>
      </view>
    </view>
    <view wx:if="{{watchStatus === 'completed'}}" class="field">
      <view class="field-label">我的评分（必填）</view>
      <view class="rating-stars" role="group" aria-label="当前评分 {{personalRating}} 星">
        <view
          wx:for="{{ratingOptions}}"
          wx:key="*this"
          class="rating-star {{item <= personalRating ? 'rating-star--filled' : ''}}"
          data-rating="{{item}}"
          role="button"
          aria-label="评为 {{item}} 星"
          bindtap="handlePersonalRatingTap"
        >{{item <= personalRating ? '★' : '☆'}}</view>
      </view>
      <view class="field-help rating-help">新增时默认为 3 星</view>
    </view>
    <view class="field">
      <view class="field-label">封面（选填）</view>
      <view class="cover-editor" bindtap="handleChooseImage">
        <image wx:if="{{selectedImagePath}}" class="cover-editor__preview" src="{{selectedImagePath}}" mode="aspectFill" />
        <view wx:else class="cover-editor__empty">
          <app-icon name="image-plus" size="42" />
          <view>选择封面</view>
        </view>
        <view class="cover-editor__action">{{selectedImagePath ? '更换封面' : '选择封面'}}</view>
      </view>
      <view class="field-help cover-editor__help">建议使用 3:4 竖图，保存后统一输出为 1080 × 1440</view>
    </view>
    <view class="field">
      <view class="field-label">平台/来源（选填，可多选）</view>
      <checkbox-group class="platform-options" bindchange="handlePlatformsChange">
        <label wx:for="{{platformOptions}}" wx:key="name" class="platform-option">
          <checkbox value="{{item.name}}" checked="{{item.checked}}" color="#111111" />
          <text>{{item.name}}</text>
        </label>
      </checkbox-group>
    </view>
  </view>
  <view class="save-bar">
    <button class="save-button" loading="{{saving}}" disabled="{{saving || selectingImage || showImageCropper}}" bindtap="handleSave">新增</button>
  </view>
</view>

<image-cropper
  wx:if="{{showImageCropper}}"
  compact-typography="{{true}}"
  src="{{cropSourcePath}}"
  shape="rectangle"
  aspect-ratio="0.75"
  output-size="1080"
  title="裁剪为 3:4 影视封面"
  bind:cancel="handleImageCropCancel"
  bind:confirm="handleImageCropConfirm"
  bind:error="handleImageCropError"
/>

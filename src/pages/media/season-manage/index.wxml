<custom-navigation title="剧集管理" custom-back bind:back="handleBack" />

<view wx:if="{{loading}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在加载剧集…</view>
</view>

<view wx:else class="page page--with-navigation">
  <scroll-view class="season-manager-scroll" scroll-y="{{draggingSortKey === ''}}" scroll-top="{{managerScrollTop}}" enhanced bounces="{{false}}" show-scrollbar="{{false}}" bindscroll="handleManagerScroll">
    <view class="season-list">
      <view
        wx:for="{{draftSeasons}}"
        wx:key="key"
        style="{{dragSortKind === 'season' ? dragSortPreviewStyles[index] : ''}}"
        class="season-card js-season-sort-item {{expandedSeasonKey === item.key ? 'season-card--expanded' : ''}} {{draggingSortKey === item.key ? 'season-card--dragging' : ''}}"
      >
        <view class="season-card__header js-season-sort-anchor">
          <view
            class="season-card__drag-handle"
            role="button"
            aria-label="长按拖拽调整{{item.name || '未命名季'}}顺序"
            data-index="{{index}}"
            catchlongpress="handleSeasonDragLongPress"
            catchtouchmove="handleSortDragMove"
            catchtouchend="handleSortDragEnd"
            catchtouchcancel="handleSortDragEnd"
          ><app-icon name="drag-handle" size="27" /></view>
          <view class="season-card__heading" role="button" aria-label="{{expandedSeasonKey === item.key ? '收起' : '展开'}}{{item.name}}" data-key="{{item.key}}" bindtap="handleSeasonToggle">
            <view class="season-card__heading-copy">
              <view class="season-card__name">{{item.name || '未命名季'}}</view>
              <view class="season-card__count">{{item.episodes.length}} 集</view>
            </view>
            <app-icon name="{{expandedSeasonKey === item.key ? 'arrow-up' : 'chevron-down'}}" size="24" />
          </view>
          <view class="season-card__delete" role="button" aria-label="删除{{item.name}}" data-index="{{index}}" catchtap="handleSeasonDeleteRequest">
            <app-icon name="trash-2-danger" size="24" />
          </view>
        </view>

        <view wx:if="{{expandedSeasonKey === item.key}}" class="season-editor">
          <view class="season-editor__fields">
            <view class="season-field" role="button" aria-label="修改季名称" data-index="{{index}}" bindtap="handleSeasonNameTap">
              <view class="season-field__label">季名称</view>
              <view class="season-field__value">{{item.name || '未命名季'}}</view>
              <app-icon name="chevron-right" size="16" />
            </view>

            <view class="season-field" role="button" aria-label="修改总集数" data-index="{{index}}" bindtap="handleEpisodeCountTap">
              <view class="season-field__label">总集数</view>
              <view class="season-field__value">{{item.episodes.length}} 集</view>
              <app-icon name="chevron-right" size="16" />
            </view>
          </view>

          <view class="episode-editor-heading">单集详情</view>
          <view wx:if="{{item.episodes.length === 0}}" class="episode-editor-empty">当前季还没有单集</view>
          <view wx:else class="episode-editor-list">
            <view
              wx:for="{{item.episodes}}"
              wx:for-item="episode"
              wx:for-index="episodeIndex"
              wx:key="key"
              style="{{dragSortKind === 'episode' ? dragSortPreviewStyles[episodeIndex] : ''}}"
              class="episode-editor-row js-episode-sort-item {{draggingSortKey === episode.key ? 'episode-editor-row--dragging' : ''}}"
            >
              <view
                class="episode-editor-row__drag-handle"
                role="button"
                aria-label="长按拖拽调整第 {{episodeIndex + 1}} 集顺序"
                data-season-index="{{index}}"
                data-episode-index="{{episodeIndex}}"
                catchlongpress="handleEpisodeDragLongPress"
                catchtouchmove="handleSortDragMove"
                catchtouchend="handleSortDragEnd"
                catchtouchcancel="handleSortDragEnd"
              ><app-icon name="drag-handle" size="27" /></view>
              <view class="episode-editor-row__copy">
                <view class="episode-editor-row__title" role="button" aria-label="修改第 {{episodeIndex + 1}} 集名称" data-season-index="{{index}}" data-episode-index="{{episodeIndex}}" bindtap="handleEpisodeTitleTap">{{episode.title || '第 ' + (episodeIndex + 1) + ' 集'}}</view>
                <view class="episode-editor-row__summary {{episode.plot_summary ? '' : 'episode-editor-row__summary--empty'}}" role="button" aria-label="查看并编辑第 {{episodeIndex + 1}} 集剧情详情" data-season-index="{{index}}" data-episode-index="{{episodeIndex}}" bindtap="handleEpisodeSummaryTap">{{episode.plot_summary || '点击添加剧情详情'}}</view>
              </view>
              <view class="episode-editor-row__favorite {{episode.is_favorite ? 'episode-editor-row__favorite--active' : ''}}" role="button" aria-label="{{episode.is_favorite ? '取消喜欢本集' : '喜欢本集'}}" data-season-index="{{index}}" data-episode-index="{{episodeIndex}}" bindtap="handleEpisodeFavoriteTap"><app-icon name="{{episode.is_favorite ? 'heart-favorite-filled' : 'heart-muted'}}" size="30" /></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <button class="season-add" bindtap="handleSeasonAdd"><app-icon name="plus" size="24" /><text>新增季</text></button>
    <view class="season-manager-safe-area" />
  </scroll-view>

  <view class="season-manager-save-bar">
    <button class="season-manager-save" disabled="{{!dirty || saving}}" bindtap="handleSaveRequest">保存</button>
  </view>

  <sort-drag-ghost visible="{{draggingSortKey !== ''}}" title="{{dragSortGhostTitle}}" meta="{{dragSortGhostMeta}}" custom-style="{{dragSortGhostStyle}}" />
</view>

<operation-loading visible="{{saving}}" text="正在保存剧集…" />

<app-field-editor visible="{{fieldEditorVisible}}" title="{{fieldEditorTitle}}" value="{{fieldEditorValue}}" type="{{fieldEditorType}}" placeholder="{{fieldEditorPlaceholder}}" maxlength="{{fieldEditorMaxlength}}" hint="{{fieldEditorHint}}" show-count="{{fieldEditorShowCount}}" bind:cancel="handleFieldEditorCancel" bind:confirm="handleFieldEditorConfirm" />

<app-dialog wx:if="{{confirmDialogVisible}}" visible="{{true}}" title="{{confirmDialogPurpose === 'leave' ? '放弃修改' : '确认保存'}}" content="{{confirmDialogContent}}" confirm-text="{{confirmDialogPurpose === 'leave' ? '放弃' : '保存'}}" bind:cancel="handleConfirmCancel" bind:confirm="handleConfirmAction" />

<app-dialog wx:if="{{deleteDialogVisible}}" visible="{{true}}" title="删除本季" content="删除后，该季和其中的单集会在最终保存时一并删除。" confirm-text="删除" bind:cancel="handleSeasonDeleteCancel" bind:confirm="handleSeasonDeleteConfirm" />

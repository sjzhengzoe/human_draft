<custom-navigation title="影视片单" />

<view wx:if="{{loading && !hasLoaded}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在加载影视记录…</view>
</view>

<view wx:else class="page page--fixed">
  <view class="media-header">
    <view class="view-switch" role="tablist" aria-label="影视记录视图">
      <view class="view-switch__item {{displayMode === 'overview' ? 'view-switch__item--active' : ''}}" data-mode="overview" bindtap="handleDisplayModeTap" role="tab">速览</view>
      <view class="view-switch__item {{displayMode === 'record' ? 'view-switch__item--active' : ''}}" data-mode="record" bindtap="handleDisplayModeTap" role="tab">记录</view>
    </view>

    <view class="media-filter-row media-filter-row--category">
      <view class="media-filter-label">分类：</view>
      <scroll-view class="media-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="category-list" role="group" aria-label="按分类筛选">
          <view class="category-chip {{selectedCategory === '' ? 'category-chip--active' : ''}}" data-type="" bindtap="handleCategoryTap">全部</view>
          <view wx:for="{{mediaTypes}}" wx:key="*this" class="category-chip {{selectedCategory === item ? 'category-chip--active' : ''}}" data-type="{{item}}" bindtap="handleCategoryTap">{{item}}</view>
        </view>
      </scroll-view>
    </view>

    <view class="media-filter-row media-filter-row--secondary">
      <block wx:if="{{displayMode === 'overview'}}">
        <view class="media-filter-label">状态：</view>
        <scroll-view class="media-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="category-list status-list" role="group" aria-label="按状态筛选">
            <view class="category-chip {{overviewStatus === 'all' ? 'category-chip--active' : ''}}" data-status="all" bindtap="handleOverviewStatusTap">全部</view>
            <view class="category-chip {{overviewStatus === 'in_progress' ? 'category-chip--active' : ''}}" data-status="in_progress" bindtap="handleOverviewStatusTap">在看</view>
            <view class="category-chip {{overviewStatus === 'planned' ? 'category-chip--active' : ''}}" data-status="planned" bindtap="handleOverviewStatusTap">想看</view>
            <view class="category-chip {{overviewStatus === 'special_favorite' ? 'category-chip--active' : ''}}" data-status="special_favorite" bindtap="handleOverviewStatusTap">特别喜爱</view>
          </view>
        </scroll-view>
      </block>
      <block wx:else>
        <view class="media-filter-label">评分：</view>
        <scroll-view class="media-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="category-list rating-list" role="group" aria-label="按评分筛选">
            <view class="category-chip {{selectedRating === 0 ? 'category-chip--active' : ''}}" data-rating="0" bindtap="handleRatingTap">全部</view>
            <view wx:for="{{ratingOptions}}" wx:key="value" class="category-chip {{selectedRating === item.value ? 'category-chip--active' : ''}}" data-rating="{{item.value}}" bindtap="handleRatingTap">{{item.label}}</view>
          </view>
        </scroll-view>
      </block>
    </view>

    <view class="media-command-row">
      <view class="search-row">
        <view class="search-row__field">
          <app-icon name="search" size="24" />
          <app-input custom-class="search-row__input" persistent clearable clear-aria-label="清空作品搜索" value="{{keyword}}" placeholder="搜索作品名" confirm-type="search" bindinput="handleKeywordInput" bindconfirm="handleSearch" />
        </view>
      </view>
      <view wx:if="{{canWrite || guestMode}}" class="media-command-actions">
        <view class="icon-button icon-button--primary" role="button" aria-label="新增影视" bindtap="handleAdd">
          <app-icon name="plus-white" size="24" />
        </view>
        <view class="more-button" role="button" aria-label="更多影视操作" bindtap="handleMoreOpen">更多</view>
      </view>
    </view>
  </view>

  <view
    wx:if="{{!contentLoading && !errorMessage && displayMode === 'overview' && overviewItems.length}}"
    class="section-heading content-heading"
  >
    <view class="section-heading__title">{{overviewStatus === 'all' ? '全部' : overviewStatus === 'in_progress' ? '在看' : overviewStatus === 'planned' ? '想看' : '特别喜爱'}}</view>
    <view class="section-heading__count">{{overviewTotal}} 部</view>
  </view>
  <view
    wx:if="{{!contentLoading && !errorMessage && displayMode === 'record' && recordItems.length}}"
    class="record-heading content-heading"
  >
    <view class="record-heading__main">
      <view class="record-heading__title">{{selectedCategory || '全部记录'}}</view>
      <view class="record-heading__count">{{recordTotal}} 条记录</view>
    </view>
  </view>

  <scroll-view
    class="content-scroll"
    scroll-y
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
    scroll-top="{{contentScrollTop}}"
    lower-threshold="240"
    bindscroll="handleContentScroll"
    bindscrolltolower="handleContentLower"
    refresher-enabled
    refresher-triggered="{{refresherTriggered}}"
    bindrefresherrefresh="handlePullRefresh"
  >
    <view wx:if="{{contentLoading}}" class="content-loading">
      <view class="content-loading__spinner" />
      <view class="content-loading__text">正在加载影视记录…</view>
    </view>
    <view wx:elif="{{errorMessage}}" class="state-block">
      <view>{{errorMessage}}</view>
      <button class="retry-button" bindtap="handleRetry">重试</button>
    </view>

    <block wx:elif="{{displayMode === 'overview'}}">
      <view wx:if="{{overviewItems.length}}" class="record-grid overview-grid">
          <view wx:for="{{overviewItems}}" wx:key="id" class="record-card" data-id="{{item.id}}" bindtap="handleItemTap">
            <view class="record-card__cover-frame">
              <image wx:if="{{item.coverImageUrl}}" class="record-card__cover" src="{{item.coverImageUrl}}" mode="aspectFill" lazy-load />
              <view wx:else class="record-card__cover record-card__cover--empty"><app-icon name="{{item.placeholderIcon}}" size="30" /></view>
              <view class="record-card__overlay">
                <view class="record-card__title">{{item.title}}</view>
                <view wx:if="{{item.watch_status === 'completed'}}" class="record-card__rating" aria-label="{{item.personal_rating ? item.personal_rating + ' 星' : '未评分'}}">
                  <text
                    wx:for="{{item.ratingStars}}"
                    wx:for-item="ratingStar"
                    wx:key="position"
                    class="record-card__rating-star {{ratingStar.filled ? 'record-card__rating-star--filled' : ''}}"
                  >{{ratingStar.filled ? '★' : '☆'}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      <view wx:else class="state-block">
        <text>目前还没有任何数据哦~</text>
      </view>
      <view wx:if="{{loadingMore}}" class="load-more">正在加载…</view>
    </block>

    <block wx:else>
      <view wx:if="{{recordItems.length}}" class="record-grid">
        <view wx:for="{{recordItems}}" wx:key="id" class="record-card" data-id="{{item.id}}" bindtap="handleItemTap">
          <view class="record-card__cover-frame">
            <image wx:if="{{item.coverImageUrl}}" class="record-card__cover" src="{{item.coverImageUrl}}" mode="aspectFill" lazy-load />
            <view wx:else class="record-card__cover record-card__cover--empty"><app-icon name="{{item.placeholderIcon}}" size="30" /></view>
            <view class="record-card__overlay">
              <view class="record-card__title">{{item.title}}</view>
              <view wx:if="{{item.watch_status === 'completed'}}" class="record-card__rating" aria-label="{{item.personal_rating ? item.personal_rating + ' 星' : '未评分'}}">
                <text
                  wx:for="{{item.ratingStars}}"
                  wx:for-item="ratingStar"
                  wx:key="position"
                  class="record-card__rating-star {{ratingStar.filled ? 'record-card__rating-star--filled' : ''}}"
                >{{ratingStar.filled ? '★' : '☆'}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="state-block">
        <text>目前还没有任何数据哦~</text>
      </view>
      <view wx:if="{{loadingMore}}" class="load-more">正在加载…</view>
    </block>
  </scroll-view>
</view>

<app-dialog
  visible="{{moreMenuVisible}}"
  placement="bottom"
  title="更多操作"
  custom-body="{{true}}"
  custom-actions="{{true}}"
  bindcancel="handleMoreClose"
>
  <view slot="body" class="more-action-list">
    <view class="more-action-item" role="button" aria-label="管理影视分类" bindtap="handleManageCategories">
      <app-icon name="settings-2" size="27" />
      <text>管理影视分类</text>
    </view>
  </view>
  <view slot="actions" class="more-dialog-actions">
    <button class="more-dialog-close" bindtap="handleMoreClose">取消</button>
  </view>
</app-dialog>

<login-required-dialog id="login-required-dialog" />

<custom-navigation title="影视记录" />

<view wx:if="{{loading && !hasLoaded}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在加载影视记录…</view>
</view>

<view wx:else class="page page--fixed">
  <view class="media-header">
    <view class="view-switch" role="tablist" aria-label="影视记录视图">
      <view class="view-switch__item {{displayMode === 'overview' ? 'view-switch__item--active' : ''}}" data-mode="overview" bindtap="handleDisplayModeTap" role="tab">速览</view>
      <view class="view-switch__item {{displayMode === 'record' ? 'view-switch__item--active' : ''}}" data-mode="record" bindtap="handleDisplayModeTap" role="tab">记录</view>
    </view>

    <view class="media-toolbar">
      <picker wx:if="{{displayMode === 'overview'}}" class="category-picker" range="{{overviewCategoryOptions}}" value="{{overviewCategoryIndex}}" bindchange="handleOverviewCategoryChange">
        <view class="category-picker__button">
          <text>{{overviewCategoryOptions[overviewCategoryIndex]}}</text>
          <app-icon name="chevron-down" size="22" />
        </view>
      </picker>

      <view class="media-toolbar__actions">
        <view wx:if="{{canWrite}}" class="icon-button" role="button" aria-label="管理影视分类" bindtap="handleManageCategories">
          <app-icon name="settings-2" size="23" />
        </view>
        <view wx:if="{{canWrite}}" class="icon-button icon-button--primary" role="button" aria-label="新增影视" bindtap="handleAdd">
          <app-icon name="plus-white" size="23" />
        </view>
      </view>
    </view>

    <block wx:if="{{displayMode === 'record'}}">
      <view class="filter-heading">
        <text>选择分类</text>
        <text class="filter-heading__hint">包含全部记录</text>
      </view>
      <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="category-list">
          <view class="category-chip {{activeRecordType === '' ? 'category-chip--active' : ''}}" data-type="" bindtap="handleRecordTypeTap">全部</view>
          <view wx:for="{{mediaTypes}}" wx:key="*this" class="category-chip {{activeRecordType === item ? 'category-chip--active' : ''}}" data-type="{{item}}" bindtap="handleRecordTypeTap">{{item}}</view>
        </view>
      </scroll-view>
      <view class="search-row">
        <app-input custom-class="search-row__input" value="{{keyword}}" placeholder="搜索作品名" confirm-type="search" bindinput="handleKeywordInput" bindconfirm="handleSearch" />
        <view wx:if="{{appliedKeyword}}" class="search-row__clear" bindtap="handleClearSearch">清除</view>
        <view class="search-row__button" bindtap="handleSearch">搜索</view>
      </view>
    </block>
  </view>

  <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{contentLoading}}" class="content-loading">
      <view class="content-loading__spinner" />
      <view class="content-loading__text">正在加载影视记录…</view>
    </view>
    <view wx:elif="{{errorMessage}}" class="state-block">
      <view>{{errorMessage}}</view>
      <button class="retry-button" bindtap="handleRetry">重试</button>
    </view>

    <block wx:elif="{{displayMode === 'overview'}}">
      <view class="overview-section">
        <view class="section-heading">
          <view class="section-heading__title">正在看</view>
          <view class="section-heading__count">{{inProgressItems.length}} 部</view>
        </view>
        <view wx:if="{{inProgressItems.length}}" class="record-grid overview-grid">
          <view wx:for="{{inProgressItems}}" wx:key="id" class="record-card" data-id="{{item.id}}" bindtap="handleItemTap">
            <image wx:if="{{item.cover_url}}" class="record-card__cover" src="{{item.cover_url}}" mode="aspectFill" lazy-load />
            <view wx:else class="record-card__cover record-card__cover--empty"><app-icon name="{{item.placeholderIcon}}" size="38" /></view>
            <view class="record-card__body">
              <view class="record-card__title">{{item.title}}</view>
              <view class="record-card__meta">{{item.metaText}}</view>
              <view wx:if="{{item.statsText || item.favoriteText || item.is_revisitable}}" class="record-card__details">
                <view wx:if="{{item.statsText}}">{{item.statsText}}</view>
                <view wx:if="{{item.favoriteText}}">{{item.favoriteText}}</view>
                <view wx:if="{{item.is_revisitable}}">值得重温</view>
              </view>
            </view>
          </view>
        </view>
        <view wx:else class="section-empty">没有正在看的作品</view>
      </view>

      <view class="overview-section">
        <view class="section-heading">
          <view class="section-heading__title">想看</view>
          <view class="section-heading__count">{{plannedItems.length}} 部</view>
        </view>
        <view wx:if="{{plannedItems.length}}" class="record-grid overview-grid">
          <view wx:for="{{plannedItems}}" wx:key="id" class="record-card" data-id="{{item.id}}" bindtap="handleItemTap">
            <image wx:if="{{item.cover_url}}" class="record-card__cover" src="{{item.cover_url}}" mode="aspectFill" lazy-load />
            <view wx:else class="record-card__cover record-card__cover--empty"><app-icon name="{{item.placeholderIcon}}" size="38" /></view>
            <view class="record-card__body">
              <view class="record-card__title">{{item.title}}</view>
              <view class="record-card__meta">{{item.metaText}}</view>
              <view wx:if="{{item.statsText || item.favoriteText || item.is_revisitable}}" class="record-card__details">
                <view wx:if="{{item.statsText}}">{{item.statsText}}</view>
                <view wx:if="{{item.favoriteText}}">{{item.favoriteText}}</view>
                <view wx:if="{{item.is_revisitable}}">值得重温</view>
              </view>
            </view>
          </view>
        </view>
        <view wx:else class="section-empty">还没有想看的作品</view>
      </view>
      <view class="content-footer">没有更多了</view>
    </block>

    <block wx:else>
      <view class="record-heading">
        <view class="record-heading__main">
          <view class="record-heading__title">{{activeRecordType || '全部记录'}}</view>
          <view class="record-heading__count">{{recordItems.length}} 条记录</view>
        </view>
        <view class="record-heading__hint">四列卡片</view>
      </view>
      <view wx:if="{{recordItems.length}}" class="record-grid">
        <view wx:for="{{recordItems}}" wx:key="id" class="record-card" data-id="{{item.id}}" bindtap="handleItemTap">
          <image wx:if="{{item.cover_url}}" class="record-card__cover" src="{{item.cover_url}}" mode="aspectFill" lazy-load />
          <view wx:else class="record-card__cover record-card__cover--empty"><app-icon name="{{item.placeholderIcon}}" size="38" /></view>
          <view class="record-card__body">
            <view class="record-card__title">{{item.title}}</view>
            <view class="record-card__meta">{{item.metaText}}</view>
            <view wx:if="{{item.statsText || item.favoriteText || item.is_revisitable}}" class="record-card__details">
              <view wx:if="{{item.statsText}}">{{item.statsText}}</view>
              <view wx:if="{{item.favoriteText}}">{{item.favoriteText}}</view>
              <view wx:if="{{item.is_revisitable}}">值得重温</view>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="state-block">{{appliedKeyword ? '没有找到相关作品' : '这个分类还没有记录'}}</view>
      <view wx:if="{{recordItems.length}}" class="content-footer">共 {{recordItems.length}} 条记录</view>
    </block>
  </scroll-view>
</view>

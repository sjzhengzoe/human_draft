<custom-navigation title="影视记录" compact-title="{{true}}" />

<view wx:if="{{loading && !hasLoaded}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在加载影视记录…</view>
</view>

<view wx:else class="page page--fixed">
  <view class="media-header">
    <view class="view-switch" role="tablist" aria-label="影视记录视图">
      <view class="view-switch__item {{displayMode === 'overview' ? 'view-switch__item--active' : ''}}" data-mode="overview" bindtap="handleDisplayModeTap" role="tab">速览</view>
      <view class="view-switch__item {{displayMode === 'record' ? 'view-switch__item--active' : ''}}" data-mode="record" bindtap="handleDisplayModeTap" role="tab">记录</view>
    </view>

    <block wx:if="{{displayMode === 'overview'}}">
      <view class="filter-heading">
        <text>选择分类</text>
      </view>
      <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="category-list">
          <view class="category-chip {{selectedCategory === '' ? 'category-chip--active' : ''}}" data-type="" bindtap="handleCategoryTap">全部</view>
          <view wx:for="{{mediaTypes}}" wx:key="*this" class="category-chip {{selectedCategory === item ? 'category-chip--active' : ''}}" data-type="{{item}}" bindtap="handleCategoryTap">{{item}}</view>
        </view>
      </scroll-view>
      <view class="filter-heading filter-heading--status">
        <text>选择状态</text>
      </view>
      <view class="category-list status-list">
        <view class="category-chip {{overviewStatus === 'in_progress' ? 'category-chip--active' : ''}}" data-status="in_progress" bindtap="handleOverviewStatusTap">正在看</view>
        <view class="category-chip {{overviewStatus === 'planned' ? 'category-chip--active' : ''}}" data-status="planned" bindtap="handleOverviewStatusTap">想看</view>
      </view>
    </block>

    <block wx:else>
      <view class="filter-heading">
        <text>选择分类</text>
      </view>
      <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="category-list">
          <view class="category-chip {{selectedCategory === '' ? 'category-chip--active' : ''}}" data-type="" bindtap="handleCategoryTap">全部</view>
          <view wx:for="{{mediaTypes}}" wx:key="*this" class="category-chip {{selectedCategory === item ? 'category-chip--active' : ''}}" data-type="{{item}}" bindtap="handleCategoryTap">{{item}}</view>
        </view>
      </scroll-view>
      <view class="search-row">
        <app-input custom-class="search-row__input" font-size="20rpx" value="{{keyword}}" placeholder="搜索作品名" confirm-type="search" bindinput="handleKeywordInput" bindconfirm="handleSearch" />
        <view wx:if="{{appliedKeyword}}" class="search-row__clear" bindtap="handleClearSearch">清除</view>
        <view class="search-row__button" bindtap="handleSearch">搜索</view>
      </view>
    </block>

    <view wx:if="{{canWrite}}" class="media-toolbar">
      <view class="media-toolbar__actions">
        <view class="icon-button" role="button" aria-label="管理影视分类" bindtap="handleManageCategories">
          <app-icon name="settings-2" size="23" />
        </view>
        <view class="icon-button icon-button--primary" role="button" aria-label="新增影视" bindtap="handleAdd">
          <app-icon name="plus-white" size="23" />
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{contentLoading}}" class="content-loading">
      <view class="content-loading__spinner" />
      <view class="content-loading__text">正在加载影视记录…</view>
    </view>
    <view wx:elif="{{errorMessage}}" class="state-block">
      <view>{{errorMessage}}</view>
      <button class="retry-button" bindtap="handleRetry">重试</button>
    </view>

    <block wx:elif="{{displayMode === 'overview'}}">
      <view class="overview-section">
        <view class="section-heading">
          <view class="section-heading__title">{{overviewStatus === 'in_progress' ? '正在看' : '想看'}}</view>
          <view class="section-heading__count">{{overviewItems.length}} 部</view>
        </view>
        <view wx:if="{{overviewItems.length}}" class="record-grid overview-grid">
          <view wx:for="{{overviewItems}}" wx:key="id" class="record-card" data-id="{{item.id}}" bindtap="handleItemTap">
            <view class="record-card__cover-frame">
              <image wx:if="{{item.cover_url}}" class="record-card__cover" src="{{item.cover_url}}" mode="aspectFill" lazy-load />
              <view wx:else class="record-card__cover record-card__cover--empty"><app-icon name="{{item.placeholderIcon}}" size="38" /></view>
              <view
                class="record-card__revisit {{item.is_revisitable ? 'record-card__revisit--active' : ''}} {{revisitableUpdatingId === item.id ? 'record-card__revisit--updating' : ''}}"
                data-id="{{item.id}}"
                role="button"
                aria-label="{{item.is_revisitable ? '取消值得重温' : '设为值得重温'}}"
                catchtap="handleRevisitableTap"
              >{{item.is_revisitable ? '♥' : '♡'}}</view>
            </view>
            <view class="record-card__body">
              <view class="record-card__title">{{item.title}}</view>
            </view>
          </view>
        </view>
        <view wx:else class="section-empty">{{overviewStatus === 'in_progress' ? '没有正在看的作品' : '还没有想看的作品'}}</view>
      </view>
      <view class="content-footer">没有更多了</view>
    </block>

    <block wx:else>
      <view class="record-heading">
        <view class="record-heading__main">
          <view class="record-heading__title">{{selectedCategory || '全部记录'}}</view>
          <view class="record-heading__count">{{recordItems.length}} 条记录</view>
        </view>
      </view>
      <view wx:if="{{recordItems.length}}" class="record-grid">
        <view wx:for="{{recordItems}}" wx:key="id" class="record-card" data-id="{{item.id}}" bindtap="handleItemTap">
          <view class="record-card__cover-frame">
            <image wx:if="{{item.cover_url}}" class="record-card__cover" src="{{item.cover_url}}" mode="aspectFill" lazy-load />
            <view wx:else class="record-card__cover record-card__cover--empty"><app-icon name="{{item.placeholderIcon}}" size="38" /></view>
            <view
              class="record-card__revisit {{item.is_revisitable ? 'record-card__revisit--active' : ''}} {{revisitableUpdatingId === item.id ? 'record-card__revisit--updating' : ''}}"
              data-id="{{item.id}}"
              role="button"
              aria-label="{{item.is_revisitable ? '取消值得重温' : '设为值得重温'}}"
              catchtap="handleRevisitableTap"
            >{{item.is_revisitable ? '♥' : '♡'}}</view>
          </view>
          <view class="record-card__body">
            <view class="record-card__title">{{item.title}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="state-block">{{appliedKeyword ? '没有找到相关作品' : '这个分类还没有记录'}}</view>
      <view wx:if="{{recordItems.length}}" class="content-footer">共 {{recordItems.length}} 条记录</view>
    </block>
  </scroll-view>
</view>

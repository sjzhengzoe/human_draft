<view class="creation-screen">
  <view class="creation-navigation">
    <custom-navigation title="图文创作" />
  </view>

<view class="page">
  <view class="template-switch {{isGenerating || selectingImage ? 'template-switch--disabled' : ''}}" role="tablist" aria-label="选择图文模板" aria-disabled="{{isGenerating || selectingImage}}">
    <view
      class="template-switch__item"
      role="tab"
      aria-selected="false"
      data-template="xiaohongshu"
      bindtap="handleTemplateChange"
    >模板一</view>
    <view
      class="template-switch__item"
      role="tab"
      aria-selected="false"
      data-template="douyin2"
      bindtap="handleTemplateChange"
    >模板二</view>
    <view
      class="template-switch__item template-switch__item--active"
      role="tab"
      aria-selected="true"
      data-template="douyin3"
      bindtap="handleTemplateChange"
    >模板三</view>
  </view>

  <view wx:if="{{isExampleContent}}" class="example-notice">
    <text class="example-notice__title">当前是默认文案</text>
    <text class="example-notice__desc">请编辑文案后再导出</text>
  </view>

  <view wx:if="{{!hasCustomContent && !isExampleContent}}" class="card-swiper card-slide">
    <view class="card-item card-item--empty">
      <view class="card-loading card-empty-state">
        <view class="card-empty-state__content">
          <view class="card-loading__title">开始创作</view>
          <view class="card-loading__desc">复制模板，按示例填写内容</view>
          <button class="card-empty-state__copy" bindtap="handleCopyTemplate">
            <text>复制模板</text>
          </button>
        </view>
      </view>
    </view>
  </view>

  <swiper
    wx:else
    class="card-swiper"
    current="{{activeIndex}}"
    indicator-dots="{{renderedImageUrls.length > 1}}"
    indicator-color="rgba(0, 0, 0, 0.18)"
    indicator-active-color="#111111"
    bindchange="handleSwiperChange"
  >
    <swiper-item wx:for="{{renderedImageUrls}}" wx:key="*this" class="card-slide">
      <view class="card-item">
        <image class="card-image" src="{{item}}" mode="widthFix" />
        <view wx:if="{{renderError}}" class="card-preview-overlay">
          <view class="card-preview-overlay__title">{{renderErrorMessage}}</view>
          <button class="card-preview-overlay__retry" bindtap="retryPreview">重新生成</button>
        </view>
        <view wx:elif="{{isRenderingCards}}" class="card-preview-overlay">
          <view class="card-preview-overlay__spinner" />
          <view class="card-preview-overlay__title">正在更新预览 {{renderProgressText}}</view>
        </view>
        <view
          wx:if="{{!isExampleContent}}"
          class="circle-image-picker {{selectedImagePaths[index] ? 'circle-image-picker--selected' : ''}} {{selectingImage && selectingImageIndex === index ? 'circle-image-picker--loading' : ''}}"
          data-index="{{index}}"
          role="button"
          aria-label="{{selectedImagePaths[index] ? '更换圆形图片' : '添加圆形图片'}}"
          catchtap="handleChooseCircleImage"
        >
          <image
            wx:if="{{selectedImagePaths[index]}}"
            class="circle-image-picker__image"
            src="{{selectedImagePaths[index]}}"
            mode="aspectFill"
          />
          <view wx:else class="circle-image-picker__placeholder">
            <app-icon name="image-plus" size="32" />
          </view>
          <view wx:if="{{selectingImage && selectingImageIndex === index}}" class="circle-image-picker__mask">处理中</view>
        </view>
      </view>
    </swiper-item>

    <swiper-item wx:if="{{!renderedImageUrls.length && renderError}}" class="card-slide">
      <view class="card-item card-item--preview-loading">
        <view class="card-loading">
          <view class="card-loading__title">{{renderErrorMessage}}</view>
          <view class="card-loading__desc">文案和图片不会丢失，可以重新生成预览</view>
          <button class="card-loading__retry" bindtap="retryPreview">重新生成</button>
        </view>
      </view>
    </swiper-item>

    <swiper-item wx:elif="{{!renderedImageUrls.length}}" class="card-slide">
      <view class="card-item card-item--preview-loading">
        <view class="card-loading">
          <view class="card-loading__title">正在生成预览 {{renderProgressText}}</view>
          <view class="card-loading__desc">完成后可导出高清图片</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="page-count" wx:if="{{pages.length}}">
    预览 · {{activeIndex + 1}} / {{pages.length}}
  </view>

  <text-card-action-bar
    disabled="{{isGenerating || selectingImage}}"
    has-content="{{hasCustomContent}}"
    export-ready="{{hasCustomContent && !isRenderingCards && !renderError && renderedImageUrls.length === pages.length}}"
    label="抖音短句操作"
    bind:action="handleAction"
  />

  <text-card-undo-bar
    visible="{{showClearUndo}}"
    bind:undo="handleUndoClear"
  />

  <canvas
    type="2d"
    id="douyin3ExportCanvas"
    class="export-canvas"
    style="width: 1px; height: 1px;"
  />

</view>
</view>

<image-cropper
  wx:if="{{showCropModal}}"
  src="{{cropSourcePath}}"
  shape="circle"
  title="裁剪圆形图片"
  bind:cancel="handleCropCancel"
  bind:confirm="handleCropConfirm"
  bind:error="handleCropError"
/>

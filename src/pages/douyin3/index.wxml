<text-card-workspace
  active-template="douyin3"
  variant="douyin3"
  disabled="{{isGenerating || selectingImage}}"
  is-example-content="{{isExampleContent}}"
  has-custom-content="{{hasCustomContent}}"
  rendered-image-urls="{{renderedImageUrls}}"
  active-index="{{activeIndex}}"
  render-error="{{renderError}}"
  render-error-message="{{renderErrorMessage}}"
  is-rendering-cards="{{isRenderingCards}}"
  render-progress-text="{{renderProgressText}}"
  content-count="{{pages.length}}"
  preview-count="{{pages.length}}"
  export-ready="{{hasCustomContent && !isRenderingCards && !renderError && renderedImageUrls.length === pages.length}}"
  action-label="抖音短句操作"
  show-clear-undo="{{showClearUndo}}"
  show-circle-image-picker="{{true}}"
  selected-image-paths="{{selectedImagePaths}}"
  selecting-image="{{selectingImage}}"
  selecting-image-index="{{selectingImageIndex}}"
  bind:templatechange="handleTemplateChange"
  bind:copytemplate="handleCopyTemplate"
  bind:swiperchange="handleSwiperChange"
  bind:retrypreview="retryPreview"
  bind:action="handleAction"
  bind:undoclear="handleUndoClear"
  bind:choosecircleimage="handleChooseCircleImage"
  bind:navigationback="handleNavigationBack"
/>

<canvas
  type="2d"
  id="douyin3ExportCanvas"
  class="export-canvas"
  style="width: 1px; height: 1px;"
/>

<image-cropper
  wx:if="{{showCropModal}}"
  src="{{cropSourcePath}}"
  shape="circle"
  title="裁剪圆形图片"
  bind:cancel="handleCropCancel"
  bind:confirm="handleCropConfirm"
  bind:error="handleCropError"
/>

<custom-navigation title="编辑文案" />

<view class="page page--with-navigation">
  <textarea
    wx:if="{{fontReady}}"
    class="editor-textarea"
    value="{{content}}"
    maxlength="{{20000}}"
    auto-height="{{false}}"
    cursor-spacing="160"
    adjust-position="{{false}}"
    show-confirm-bar="{{false}}"
    placeholder="输入文案"
    bindinput="handleInput"
  />
  <view wx:else class="editor-font-loading">正在加载编辑框</view>

  <view class="editor-actions">
    <button class="btn-primary" bindtap="saveContent">保存</button>
    <button class="btn-secondary" bindtap="clearContent">清空</button>
  </view>
</view>

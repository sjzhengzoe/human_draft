<custom-navigation title="衣物尺寸" />

<view wx:if="{{loading && !hasLoaded}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在整理衣橱…</view>
</view>

<view wx:else class="page page--fixed">
  <view class="category-toolbar">
    <scroll-view class="category-tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="category-tabs__inner">
        <view
          class="category-tab {{activeCategoryId === '' ? 'category-tab--active' : ''}}"
          data-id=""
          bindtap="handleCategoryTap"
        >全部</view>
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="category-tab {{activeCategoryId === item.id ? 'category-tab--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="handleCategoryTap"
        >{{item.name}}</view>
      </view>
    </scroll-view>
    <view class="category-toolbar__actions">
      <view
        class="category-toolbar__action"
        role="button"
        aria-label="管理分类"
        bindtap="handleManageCategories"
      ><app-icon name="settings-2" size="24" /></view>
      <view
        class="category-toolbar__action category-toolbar__action--primary"
        role="button"
        aria-label="新增衣物"
        bindtap="handleAddItem"
      ><app-icon name="plus-white" size="24" /></view>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="state-block">
    <view>{{errorMessage}}</view>
    <button class="state-block__button" bindtap="handleRetry">重试</button>
  </view>

  <view wx:elif="{{items.length === 0}}" class="empty-state">
    <view class="empty-state__title">暂无衣物</view>
    <view class="empty-state__desc">点击右上方的“＋”开始记录</view>
  </view>

  <scroll-view wx:else class="wardrobe-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <swiper
      class="garment-swiper"
      current="{{activeItemIndex}}"
      circular="{{items.length > 1}}"
      duration="220"
      style="height: {{swiperHeightRpx}}rpx;"
      bindchange="handleSwiperChange"
    >
      <swiper-item wx:for="{{items}}" wx:key="id">
        <view class="garment-card" style="height: {{item.cardHeightRpx}}rpx;">
          <image
            class="garment-card__image"
            src="{{item.thumbnail_url || item.image_url}}"
            mode="aspectFit"
            lazy-load
          />

          <view class="garment-card__heading">
            <view class="garment-card__identity">
              <view class="garment-card__name">{{item.name}}</view>
              <view class="garment-card__category">{{item.categoryName}}</view>
            </view>
            <view
              class="garment-card__edit"
              role="button"
              aria-label="编辑{{item.name}}"
              data-id="{{item.id}}"
              catchtap="handleEditItem"
            ><app-icon name="pencil" size="24" /></view>
          </view>

          <view wx:if="{{item.displayValues.length}}" class="measurement-list">
            <view
              wx:for="{{item.displayValues}}"
              wx:for-item="measurement"
              wx:key="id"
              class="measurement-row"
              style="min-height: {{measurement.rowHeightRpx}}rpx;"
            >
              <text class="measurement-row__name">{{measurement.name}}</text>
              <text class="measurement-row__value">{{measurement.value}}</text>
            </view>
          </view>
          <view wx:else class="measurement-empty">这个分类还没有配置尺寸</view>
        </view>
      </swiper-item>
    </swiper>

    <view class="garment-counter">{{activeItemIndex + 1}} / {{items.length}}</view>
    <view class="bottom-space" />
  </scroll-view>

  <view wx:if="{{contentLoading}}" class="content-loading-mask">
    <view class="content-loading__spinner" />
  </view>

  <app-dialog
    visible="{{showCreateCategoryDialog}}"
    title="先创建分类"
    content="新增衣物前，需要先创建一个分类和对应的尺寸属性。"
    cancel-text="暂不创建"
    confirm-text="创建分类"
    bindcancel="handleCreateCategoryDialogCancel"
    bindconfirm="handleCreateCategoryDialogConfirm"
  />
</view>

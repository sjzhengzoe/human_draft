<custom-navigation title="管理行李场景" />

<view wx:if="{{loading && !hasLoaded}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在加载场景…</view>
</view>

<view wx:else class="page page--fixed">
  <view class="manager-header">
    <view>
      <view class="manager-header__title">场景列表</view>
      <view class="manager-header__count">{{scenes.length}} 个场景</view>
    </view>
    <view class="manager-header__actions">
      <view
        wx:if="{{scenes.length > 1}}"
        class="manager-header__tool {{sortEditing ? 'manager-header__tool--active' : ''}}"
        role="button"
        aria-label="{{sortEditing ? '完成行李场景排序' : '调整行李场景顺序'}}"
        aria-pressed="{{sortEditing}}"
        aria-disabled="{{savingOrder}}"
        bindtap="handleSortEditingToggle"
      >
        <app-icon name="{{sortEditing ? 'check-white' : 'settings-2'}}" size="23" />
      </view>
      <view
        wx:if="{{!sortEditing}}"
        class="manager-header__add"
        role="button"
        aria-label="新增行李场景"
        bindtap="handleAdd"
      >
        <app-icon name="plus-white" size="21" />
      </view>
    </view>
  </view>

  <scroll-view class="manager-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{errorMessage}}" class="state">
      <view>{{errorMessage}}</view>
      <view class="retry-button" role="button" bindtap="handleRetry">重试</view>
    </view>
    <view wx:elif="{{scenes.length === 0}}" class="state">还没有场景，点击上方新增</view>
    <view wx:else class="scene-list">
      <view
        wx:for="{{scenes}}"
        wx:key="id"
        class="scene-card {{sortEditing ? 'scene-card--sorting' : 'scene-card--editable'}}"
        role="{{sortEditing ? '' : 'button'}}"
        aria-label="{{sortEditing ? item.name : '编辑' + item.name + '场景'}}"
        data-id="{{item.id}}"
        bindtap="handleEdit"
      >
        <view class="scene-card__main">
          <view class="scene-card__name">{{item.name}}</view>
          <view class="scene-card__fields">{{item.group_count}} 个层级 · {{item.item_count}} 件物品</view>
        </view>
        <view wx:if="{{sortEditing}}" class="scene-card__sort">
          <view
            class="sort-control {{index === 0 ? 'sort-control--disabled' : ''}}"
            role="button"
            aria-label="上移{{item.name}}"
            aria-disabled="{{index === 0}}"
            data-index="{{index}}"
            data-direction="-1"
            catchtap="handleSceneMove"
          ><app-icon name="arrow-up" size="23" /></view>
          <view
            class="sort-control {{index === scenes.length - 1 ? 'sort-control--disabled' : ''}}"
            role="button"
            aria-label="下移{{item.name}}"
            aria-disabled="{{index === scenes.length - 1}}"
            data-index="{{index}}"
            data-direction="1"
            catchtap="handleSceneMove"
          ><app-icon name="arrow-down" size="23" /></view>
        </view>
        <view wx:else class="scene-card__arrow"><app-icon name="chevron-right" size="26" /></view>
      </view>
    </view>
  </scroll-view>

  <luggage-scene-dialog
    wx:if="{{sceneCreateVisible}}"
    visible="{{true}}"
    saving="{{sceneCreating}}"
    bindcancel="closeSceneCreateDialog"
    bindconfirm="createScene"
  />

  <operation-loading visible="{{savingOrder}}" text="正在保存排序…" />
</view>

<custom-navigation title="编辑行李场景" />

<view wx:if="{{loading}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在加载场景…</view>
</view>

<view wx:else class="page page--with-navigation">
  <view class="record-overview">
    <view class="record-overview__title">编辑场景</view>
    <view class="record-overview__stats">
      <view class="record-overview__stat">
        <view class="record-overview__value">{{itemCount}}</view>
        <view class="record-overview__label">物品</view>
      </view>
      <view class="record-overview__stat">
        <view class="record-overview__value">{{groupCount}}</view>
        <view class="record-overview__label">层级</view>
      </view>
    </view>
  </view>

  <view class="form-card">
    <view class="field">
      <view class="field__label">场景名称</view>
      <app-input custom-class="field__input" value="{{name}}" maxlength="80" placeholder="例如：成都三日游" bindinput="handleNameInput" />
    </view>
  </view>

  <view class="footer-actions">
    <button class="save-button" loading="{{saving}}" disabled="{{saving || deleting || !canSave}}" bindtap="handleSave">保存场景</button>
    <button class="delete-button" disabled="{{saving || deleting}}" bindtap="handleDelete"><app-icon name="trash-2-danger" size="22" /><text>删除场景</text></button>
  </view>

  <app-dialog
    wx:if="{{deleteConfirmVisible}}"
    visible="{{true}}"
    title="删除场景"
    content="场景内的全部层级和物品也会删除。"
    cancel-text="取消"
    confirm-text="删除"
    bindcancel="closeDeleteConfirm"
    bindconfirm="confirmDelete"
  />

  <app-dialog
    wx:if="{{loadErrorVisible}}"
    visible="{{true}}"
    title="加载失败"
    content="{{loadErrorMessage}}"
    custom-actions="{{true}}"
  >
    <view slot="actions" class="load-error-actions">
      <button class="load-error-button" bindtap="closeLoadError">返回</button>
    </view>
  </app-dialog>

  <operation-loading visible="{{saving || deleting}}" text="{{deleting ? '正在删除场景…' : '正在保存场景…'}}" />
</view>

<view class="creation-screen">
  <view class="creation-navigation">
    <custom-navigation title="图文创作" />
  </view>

<view class="page">
  <view class="template-switch" role="tablist" aria-label="选择图文模板">
    <view
      class="template-switch__item"
      role="tab"
      aria-selected="false"
      data-template="xiaohongshu"
      bindtap="handleTemplateChange"
    >模板一</view>
    <view
      class="template-switch__item template-switch__item--active"
      role="tab"
      aria-selected="true"
      data-template="douyin2"
      bindtap="handleTemplateChange"
    >模板二</view>
    <view
      class="template-switch__item"
      role="tab"
      aria-selected="false"
      data-template="douyin3"
      bindtap="handleTemplateChange"
    >模板三</view>
  </view>

  <view wx:if="{{isExampleContent}}" class="example-notice">
    <text class="example-notice__title">当前是默认文案</text>
    <text class="example-notice__desc">请编辑文案后再导出</text>
  </view>

  <view wx:if="{{!hasCustomContent && !isExampleContent}}" class="card-swiper card-slide">
    <view class="card-item card-item--empty">
      <view class="card-loading card-empty-state">
        <view class="card-empty-state__mark"><app-icon name="pencil" size="32" inverse="{{true}}" /></view>
        <view class="card-loading__title">开始创作</view>
        <button class="card-empty-state__copy" bindtap="handleCopyTemplate">复制模板</button>
      </view>
    </view>
  </view>

  <swiper
    wx:else
    class="card-swiper"
    current="{{activeIndex}}"
    indicator-dots="{{renderedImageUrls.length > 1}}"
    indicator-color="rgba(0, 0, 0, 0.18)"
    indicator-active-color="#111111"
    bindchange="handleSwiperChange"
  >
    <swiper-item wx:for="{{renderedImageUrls}}" wx:key="*this" class="card-slide">
      <view class="card-item">
        <image class="card-image" src="{{item}}" mode="widthFix" show-menu-by-longpress />
      </view>
    </swiper-item>

    <swiper-item wx:if="{{!renderedImageUrls.length && renderError}}" class="card-slide">
      <view class="card-item card-item--preview-loading">
        <view class="card-loading">
          <view class="card-loading__title">{{renderErrorMessage}}</view>
          <view class="card-loading__desc">文案不会丢失，可以重新生成预览</view>
          <button class="card-loading__retry" bindtap="retryPreview">重新生成</button>
        </view>
      </view>
    </swiper-item>

    <swiper-item wx:elif="{{!renderedImageUrls.length}}" class="card-slide">
      <view class="card-item card-item--preview-loading">
        <view class="card-loading">
          <view class="card-loading__title">正在生成短句卡片</view>
          <view class="card-loading__desc">正在同步预览和导出样式</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="page-count" wx:if="{{pages.length}}">
    {{activeIndex + 1}} / {{pages.length}}
  </view>

  <text-card-action-bar
    disabled="{{isGenerating}}"
    has-content="{{hasCustomContent}}"
    export-ready="{{hasCustomContent && !isRenderingCards && !renderError && renderedImageUrls.length === pages.length}}"
    label="抖音短句操作"
    bind:action="handleAction"
  />

  <text-card-undo-bar
    visible="{{showClearUndo}}"
    bind:undo="handleUndoClear"
  />

  <canvas
    type="2d"
    id="douyin2ExportCanvas"
    class="export-canvas"
    style="width: 1px; height: 1px;"
  />
</view>
</view>

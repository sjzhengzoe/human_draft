<custom-navigation
  title="详情"
  custom-back="{{true}}"
  bind:back="handleBack"
/>

<view wx:if="{{loading}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在读取节点详情…</view>
</view>

<view wx:elif="{{items.length === 0}}" class="empty-state">暂无可浏览的节点</view>

<view wx:else class="page page--with-navigation">
  <swiper
    class="detail-swiper"
    vertical="{{true}}"
    current="{{swiperCurrent}}"
    duration="280"
    easing-function="easeOutCubic"
    bindchange="handleSwiperChange"
  >
    <swiper-item wx:for="{{items}}" wx:key="id">
      <view class="detail-slide">
        <view class="detail-sheet detail-sheet--count-{{item.image_count}}">
          <view wx:if="{{item.content}}" class="detail-content">{{item.content}}</view>

          <view
            wx:if="{{item.image_count}}"
            class="detail-gallery detail-gallery--count-{{item.image_count}} {{item.content ? 'detail-gallery--after-content' : ''}}"
          >
            <image
              wx:for="{{item.image_urls}}"
              wx:for-item="imageUrl"
              wx:for-index="imageIndex"
              wx:key="*this"
              class="detail-image {{item.image_count === 1 ? 'detail-image--single' : 'detail-image--grid'}}"
              src="{{imageUrl}}"
              mode="aspectFill"
              style="{{item.image_count === 1 ? item.single_image_style : ''}}"
              data-item-index="{{index}}"
              data-id="{{item.id}}"
              data-url="{{imageUrl}}"
              aria-label="预览第 {{imageIndex + 1}} 张图片"
              bindload="handleSingleImageLoad"
              bindtap="handlePreview"
            />
          </view>

          <view class="detail-footer">
            <view class="detail-footer__date">{{item.date_label}} {{item.time_label}}</view>
            <view wx:if="{{canWrite}}" class="detail-actions">
              <view
                class="detail-edit"
                role="button"
                aria-label="编辑当前人生节点"
                bindtap="handleEdit"
              ><app-icon name="pencil" size="24" /></view>
              <view
                class="detail-delete"
                role="button"
                aria-label="删除当前人生节点"
                bindtap="handleDelete"
              ><app-icon name="trash-2-danger" size="24" /></view>
            </view>
          </view>
        </view>

      </view>
    </swiper-item>
  </swiper>

  <app-dialog
    wx:if="{{showDeleteConfirm}}"
    visible="{{true}}"
    title="删除关键节点"
    content="删除后，图片和文案都无法恢复。"
    cancel-text="取消"
    confirm-text="删除"
    bindcancel="handleDeleteConfirmCancel"
    bindconfirm="handleDeleteConfirm"
  />
</view>

<custom-navigation
  title="人生节点"
  title-tappable="{{true}}"
  bind:titletap="handleScrollToTop"
/>

<view wx:if="{{loading && !hasLoaded}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在加载人生节点…</view>
</view>

<view wx:else class="page page--fixed">
  <view class="filter-panel">
    <view class="granularity-tabs">
      <view
        wx:for="{{granularityOptions}}"
        wx:key="value"
        class="granularity-tab {{activeGranularity === item.value ? 'granularity-tab--active' : ''}}"
        data-value="{{item.value}}"
        bindtap="handleGranularityTap"
      >{{item.label}}</view>
    </view>
    <picker
      mode="date"
      fields="{{activeGranularity}}"
      value="{{anchorDate}}"
      start="1900-01-01"
      end="2100-12-31"
      bindchange="handleAnchorDateChange"
    >
      <view class="period-picker">
        <text>{{periodLabel}}</text>
        <app-icon name="chevron-down" size="27" />
      </view>
    </picker>
    <button
      wx:if="{{activeGranularity !== 'year' && canPublishInPeriod && (canWrite || guestMode)}}"
      class="add-button"
      aria-label="新增人生节点"
      bindtap="handleAdd"
    ><app-icon name="plus-white" size="27" /></button>
  </view>

  <scroll-view
    class="timeline-scroll"
    scroll-y
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
    scroll-with-animation="{{true}}"
    scroll-into-view="{{timelineScrollAnchor}}"
    lower-threshold="180"
    bindscrolltolower="handleLoadMore"
  >
    <view id="timeline-scroll-top" />
    <view
      wx:if="{{activeGranularity === 'year' && canPublishInPeriod && (canWrite || guestMode)}}"
      class="today-publisher"
    >
      <view class="today-publisher__label">今天</view>
      <view
        class="today-publisher__button"
        role="button"
        aria-label="发表今天的人生节点"
        bindtap="handleAdd"
      ><app-icon name="image-plus" size="30" /></view>
    </view>
    <view wx:if="{{contentLoading}}" class="content-loading">
      <view class="content-loading__spinner" />
      <view class="content-loading__text">正在加载…</view>
    </view>
    <view wx:elif="{{loadError && items.length === 0}}" class="state-panel">
      <view class="state-panel__title">加载失败</view>
      <view class="state-panel__message">{{loadError}}</view>
      <button class="state-panel__button" bindtap="handleRetry">重新加载</button>
    </view>
    <view wx:elif="{{items.length === 0}}" class="state-panel">
      <view class="state-panel__title">{{guestMode ? '登录后记录重要时刻' : '还没有人生节点'}}</view>
      <view class="state-panel__message">
        {{guestMode ? '你的记录会安全地保存在账号中。' : '记录一个值得记住的时刻吧。'}}
      </view>
    </view>
    <view wx:else class="timeline">
      <block wx:for="{{items}}" wx:key="id">
        <view wx:if="{{item.show_year_heading}}" class="timeline-year-heading">{{item.heading_year}}</view>
        <view
          class="timeline-entry"
          data-id="{{item.id}}"
          role="button"
          aria-label="查看人生节点详情"
          bindtap="handleMomentTap"
        >
          <view wx:if="{{item.show_date_heading}}" class="timeline-date">
            <view class="timeline-date__month">{{item.heading_month}}</view>
            <view class="timeline-date__day">{{item.heading_day}}</view>
          </view>
          <view wx:else class="timeline-date timeline-date--empty" />
          <view class="timeline-main">
            <view class="moment-card {{item.image_count === 0 ? 'moment-card--text-only' : ''}}">
              <view wx:if="{{item.content}}" class="moment-content moment-content--clamped">{{item.content}}</view>
              <view
                wx:if="{{item.image_count}}"
                class="moment-gallery moment-gallery--count-{{item.image_count}}"
              >
                <image
                  wx:for="{{item.image_urls}}"
                  wx:for-item="imageUrl"
                  wx:for-index="imageIndex"
                  wx:key="*this"
                  class="moment-image"
                  src="{{imageUrl}}"
                  mode="aspectFill"
                  lazy-load
                  data-id="{{item.id}}"
                  data-url="{{imageUrl}}"
                  aria-label="预览第 {{imageIndex + 1}} 张图片"
                  catchtap="handlePreview"
                />
              </view>
              <view class="moment-time">{{item.heading_time}}</view>
            </view>
          </view>
        </view>
        <view wx:if="{{item.show_item_divider}}" class="item-divider" />
      </block>
    </view>
    <view wx:if="{{loadingMore}}" class="load-more">正在加载更多…</view>
    <view class="scroll-safe-area" />
  </scroll-view>
</view>

<login-required-dialog id="login-required-dialog" />

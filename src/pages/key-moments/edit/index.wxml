<custom-navigation
  title="{{editingId ? '编辑' : '新增关键节点'}}"
  custom-back="{{true}}"
  bind:back="handleBack"
/>

<view wx:if="{{loading}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在读取关键节点…</view>
</view>

<view wx:else class="page page--with-navigation">
  <scroll-view class="editor-scroll" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}">
    <view class="editor-card">
      <textarea
        class="content-editor"
        value="{{editorContent}}"
        maxlength="{{maxContentLength}}"
        placeholder="不必是大事，只要这一刻对你重要，就值得记录。"
        auto-height
        show-confirm-bar="{{false}}"
        bindinput="handleEditorContentInput"
      />
      <view class="content-count">{{editorContent.length}} / {{maxContentLength}}</view>

      <view class="image-grid {{selectingImage ? 'image-grid--loading' : ''}}">
        <view
          wx:for="{{editorImages}}"
          wx:key="key"
          class="image-grid__item"
        >
          <image
            class="image-grid__preview"
            src="{{item.previewUrl}}"
            mode="aspectFill"
            data-url="{{item.previewUrl}}"
            bindtap="handlePreviewEditorImage"
          />
          <view
            class="image-grid__remove-button"
            data-index="{{index}}"
            role="button"
            aria-label="移除第 {{index + 1}} 张图片"
            catchtap="handleRemoveEditorImage"
          ><app-icon name="x-muted" size="24" inverse="{{true}}" /></view>
        </view>
        <view
          wx:if="{{canAddImage}}"
          class="image-grid__add"
          role="button"
          aria-label="添加图片，最多九张"
          bindtap="handleChooseImage"
        >
          <app-icon name="image-plus" size="30" />
        </view>
      </view>

      <view class="readonly-time">{{editorDateTimeLabel}}</view>
    </view>
    <view class="editor-safe-area" />
  </scroll-view>

  <view class="editor-actions">
    <button class="cancel-button" disabled="{{saving || selectingImage}}" bindtap="handleBack">取消</button>
    <button class="save-button" loading="{{saving}}" disabled="{{saving || selectingImage}}" bindtap="saveEditor">保存</button>
  </view>
</view>

<custom-navigation
  title="{{editingId ? '编辑关键节点' : '新增关键节点'}}"
  custom-back="{{true}}"
  bind:back="handleBack"
/>

<view wx:if="{{loading}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在读取关键节点…</view>
</view>

<view wx:else class="page page--with-navigation">
  <scroll-view class="editor-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="editor-card">
      <view class="field-label">发生时间</view>
      <view class="time-fields">
        <picker class="time-field" mode="date" value="{{editorDate}}" start="1900-01-01" end="2100-12-31" bindchange="handleEditorDateChange">
          <view class="time-field__value">{{editorDate}}</view>
        </picker>
        <picker class="time-field" mode="time" value="{{editorTime}}" bindchange="handleEditorTimeChange">
          <view class="time-field__value">{{editorTime}}</view>
        </picker>
      </view>

      <view class="field-label field-label--spaced">节点图片</view>
      <view class="image-editor {{selectingImage ? 'image-editor--loading' : ''}}">
        <image
          wx:if="{{selectedImagePath || currentImageUrl}}"
          class="image-editor__preview"
          src="{{selectedImagePath || currentImageUrl}}"
          mode="aspectFit"
          bindtap="handleChooseImage"
        />
        <view wx:else class="image-editor__empty" bindtap="handleChooseImage">
          <app-icon name="image-plus" size="30" />
          <text>{{selectingImage ? '选择中…' : '添加图片'}}</text>
        </view>
        <view
          wx:if="{{selectedImagePath || currentImageUrl}}"
          class="image-editor__remove-button"
          role="button"
          aria-label="移除图片"
          catchtap="handleRemoveEditorImage"
        ><app-icon name="x-muted" size="24" inverse="{{true}}" /></view>
      </view>

      <view class="field-label field-label--spaced">节点文字</view>
      <textarea
        class="content-input"
        value="{{editorContent}}"
        maxlength="50"
        placeholder="写下这个关键节点…"
        adjust-position="{{true}}"
        cursor-spacing="32"
        show-confirm-bar="{{false}}"
        bindinput="handleContentInput"
      />
      <view class="content-count">{{editorContent.length}} / 50</view>
    </view>
    <view class="editor-safe-area" />
  </scroll-view>

  <view class="editor-actions">
    <button class="cancel-button" disabled="{{saving || selectingImage}}" bindtap="handleBack">取消</button>
    <button class="save-button" loading="{{saving}}" disabled="{{saving || selectingImage}}" bindtap="saveEditor">保存</button>
  </view>
</view>

<image-cropper
  wx:if="{{showImageCropper}}"
  src="{{cropSourcePath}}"
  shape="rectangle"
  title="调整节点图片"
  bind:cancel="handleImageCropCancel"
  bind:confirm="handleImageCropConfirm"
  bind:error="handleImageCropError"
/>

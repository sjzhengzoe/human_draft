<custom-navigation
  title="{{editingId ? '编辑关键节点' : '新增关键节点'}}"
  custom-back="{{true}}"
  bind:back="handleBack"
/>

<view wx:if="{{loading}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在读取关键节点…</view>
</view>

<view wx:else class="page page--with-navigation">
  <scroll-view class="editor-scroll" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}">
    <view class="editor-card">
      <view class="field-label">节点文字</view>
      <view
        class="content-editor {{editorContent ? '' : 'content-editor--placeholder'}}"
        role="button"
        aria-label="编辑节点文字"
        bindtap="handleOpenContentEditor"
      >
        <text class="content-editor__text">{{editorContent || '写下这个关键节点…'}}</text>
        <view class="content-editor__icon">
          <app-icon name="pencil" size="24" />
        </view>
      </view>
      <view class="content-count">{{editorContent.length}} / 50</view>

      <view class="field-heading field-label--spaced">
        <view class="field-label">节点图片</view>
        <view class="field-heading__count">{{editorImages.length}} / 9</view>
      </view>
      <view class="image-grid {{selectingImage ? 'image-grid--loading' : ''}}">
        <view
          wx:for="{{editorImages}}"
          wx:key="key"
          class="image-grid__item"
        >
          <image
            class="image-grid__preview"
            src="{{item.previewUrl}}"
            mode="aspectFill"
            data-url="{{item.previewUrl}}"
            bindtap="handlePreviewEditorImage"
          />
          <view
            class="image-grid__remove-button"
            data-index="{{index}}"
            role="button"
            aria-label="移除第 {{index + 1}} 张图片"
            catchtap="handleRemoveEditorImage"
          ><app-icon name="x-muted" size="24" inverse="{{true}}" /></view>
        </view>
        <view
          wx:if="{{canAddImage}}"
          class="image-grid__add"
          role="button"
          aria-label="添加图片，最多九张"
          bindtap="handleChooseImage"
        >
          <app-icon name="image-plus" size="30" />
          <text>{{selectingImage ? '选择中…' : '添加'}}</text>
        </view>
      </view>

      <view class="field-label field-label--spaced">发生时间</view>
      <view class="time-fields">
        <picker class="time-field" mode="date" value="{{editorDate}}" start="1900-01-01" end="2100-12-31" bindchange="handleEditorDateChange">
          <view class="time-field__value">{{editorDate}}</view>
        </picker>
        <picker class="time-field" mode="time" value="{{editorTime}}" bindchange="handleEditorTimeChange">
          <view class="time-field__value">{{editorTime}}</view>
        </picker>
      </view>
    </view>
    <view class="editor-safe-area" />
  </scroll-view>

  <view class="editor-actions">
    <button class="cancel-button" disabled="{{saving || selectingImage}}" bindtap="handleBack">取消</button>
    <button class="save-button" loading="{{saving}}" disabled="{{saving || selectingImage}}" bindtap="saveEditor">保存</button>
  </view>
</view>

<app-dialog
  wx:if="{{contentEditorVisible}}"
  visible="{{true}}"
  placement="bottom"
  title="编辑节点文字"
  custom-body="{{true}}"
  cancel-text="取消"
  confirm-text="完成"
  bind:cancel="handleContentEditorCancel"
  bind:confirm="handleContentEditorConfirm"
>
  <view slot="body" class="content-dialog-body">
    <textarea
      class="content-dialog-input"
      value="{{contentDraft}}"
      maxlength="50"
      placeholder="写下这个关键节点…"
      focus="{{true}}"
      adjust-position="{{false}}"
      cursor-spacing="0"
      show-confirm-bar="{{false}}"
      bindinput="handleContentDraftInput"
    />
    <view class="content-dialog-count">{{contentDraft.length}} / 50</view>
  </view>
</app-dialog>

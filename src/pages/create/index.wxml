<view class="create-screen">
  <view class="create-navigation">
    <custom-navigation title="人类草稿" show-back="{{false}}" />
  </view>

  <view class="page">
    <view class="home-banner">
      <image
        class="home-banner__image"
        src="/assets/home-modules/home-banner-sleeping-cat-sofa-v2.png"
        mode="aspectFill"
        aria-hidden="{{true}}"
      />
      <view class="home-banner__greeting">{{greetingText}}</view>
    </view>

    <view
      wx:for="{{featureGroups}}"
      wx:key="key"
      wx:for-item="group"
      class="feature-section"
    >
      <view class="feature-section__title">{{group.title}}</view>
      <view class="feature-list">
        <view
          wx:for="{{group.items}}"
          wx:key="key"
          wx:for-item="item"
          class="feature-item feature-item--{{item.key}} {{item.image ? 'feature-item--illustrated' : ''}} {{item.available ? '' : 'feature-item--disabled'}}"
          hover-class="feature-item--hover"
          hover-start-time="20"
          hover-stay-time="80"
          role="button"
          aria-label="{{item.title}}{{!loggedIn && item.requiresLogin ? '，需要登录' : ''}}"
          data-key="{{item.key}}"
          data-title="{{item.title}}"
          data-path="{{item.path}}"
          data-available="{{item.available}}"
          data-requires-login="{{item.requiresLogin}}"
          bindtap="handleFeatureTap"
        >
          <image wx:if="{{item.image}}" class="feature-item__image" src="{{item.image}}" mode="aspectFill" aria-hidden="{{true}}" />
          <view wx:else class="feature-item__mark"><app-icon name="{{item.icon}}" size="30" inverse="{{true}}" /></view>
          <view
            wx:if="{{!loggedIn && item.requiresLogin}}"
            class="feature-item__login-overlay"
            aria-hidden="{{true}}"
          >
            <view class="feature-item__login-lock"><app-icon name="lock-keyhole" size="27" /></view>
          </view>
          <image
            wx:if="{{item.decoration}}"
            class="feature-item__decoration"
            src="{{item.decoration}}"
            mode="aspectFit"
            aria-hidden="{{true}}"
          />
          <view class="feature-item__content">
            <view class="feature-item__title">
              <text class="feature-item__title-text">{{item.title}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <app-dialog
    visible="{{loginDialogVisible}}"
    title="登录后使用"
    content="{{loginDialogContent}}"
    cancel-text="暂不登录"
    confirm-text="去登录"
    bindcancel="handleLoginDialogCancel"
    bindconfirm="handleLoginDialogConfirm"
  />
</view>

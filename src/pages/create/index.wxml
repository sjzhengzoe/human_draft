<view class="page">
  <view
    wx:for="{{featureGroups}}"
    wx:key="key"
    wx:for-item="group"
    class="feature-section"
  >
    <view class="feature-section__title">{{group.title}}</view>
    <view class="feature-list">
      <view
        wx:for="{{group.items}}"
        wx:key="key"
        wx:for-item="item"
        class="feature-item {{item.featured ? 'feature-item--featured' : ''}} {{item.available ? '' : 'feature-item--disabled'}}"
        hover-class="feature-item--hover"
        hover-stay-time="80"
        data-key="{{item.key}}"
        data-title="{{item.title}}"
        data-path="{{item.path}}"
        data-available="{{item.available}}"
        data-requires-login="{{item.requiresLogin}}"
        bindtap="handleFeatureTap"
      >
        <view class="feature-item__mark"><app-icon name="{{item.icon}}" size="28" /></view>
        <view class="feature-item__title">{{item.title}}</view>
      </view>
    </view>
  </view>
</view>

<custom-navigation title="聊天话题" />

<view wx:if="{{loading && !hasLoaded}}" class="fullscreen-loading">
  <view class="fullscreen-loading__spinner" />
  <view class="fullscreen-loading__text">正在准备话题…</view>
</view>

<view wx:else class="page page--fixed">
  <view class="topic-tabs">
    <view class="topic-tab {{activeTab === 'official' ? 'topic-tab--active' : ''}}" data-tab="official" bindtap="handleTabTap">官方话题</view>
    <view class="topic-tab {{activeTab === 'mine' ? 'topic-tab--active' : ''}}" data-tab="mine" bindtap="handleTabTap">我的话题</view>
    <view class="topic-tab {{activeTab === 'hidden' ? 'topic-tab--active' : ''}}" data-tab="hidden" bindtap="handleTabTap">隐藏列表</view>
  </view>

  <scroll-view class="topic-scroll" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}" scroll-into-view="{{topicScrollAnchor}}">
    <view id="topic-scroll-top" />
    <view wx:if="{{activeTab === 'official'}}" class="topic-content">
      <view class="section-heading">
        <view>
          <view class="section-heading__title">官方话题</view>
          <view class="section-heading__hint">{{officialTotal}} 个待收藏话题</view>
        </view>
        <view class="section-heading__actions">
          <button wx:if="{{isAdmin}}" class="official-add-button" bindtap="handleAddOfficialOpen">
            <app-icon name="plus-white" size="24" />
            <text>新增</text>
          </button>
        </view>
      </view>

      <view wx:if="{{contentLoading}}" class="content-loading">
        <view class="content-loading__spinner" />
        <view class="content-loading__text">正在加载…</view>
      </view>
      <view wx:elif="{{officialItems.length === 0}}" class="empty-state">
        <view class="empty-state__title">没有待收藏的话题</view>
        <view class="empty-state__hint">已收藏的在“我的话题”，隐藏的在“隐藏列表”</view>
      </view>
      <view wx:else class="my-topic-list topic-list">
        <view
          wx:for="{{officialItems}}"
          wx:key="id"
          class="my-topic-card official-topic-card"
          data-id="{{item.id}}"
          bindtap="handleEditOfficial"
        >
          <view
            wx:if="{{isAdmin}}"
            class="official-topic-card__delete"
            role="button"
            aria-label="删除官方话题"
            data-id="{{item.id}}"
            catchtap="handleOfficialDeleteOpen"
          >
            <view class="official-topic-card__delete-visual">
              <app-icon name="x-muted" size="24" />
            </view>
          </view>
          <view class="official-topic-card__top">
            <view class="my-topic-card__main">
              <view class="my-topic-card__tag">官方话题</view>
              <view class="my-topic-card__content">{{item.content}}</view>
            </view>
          </view>
          <view class="official-topic-card__footer">
            <view class="official-user-actions">
              <view class="official-inline-action" role="button" data-id="{{item.id}}" catchtap="handleDislikeOfficial">
                <view wx:if="{{hidingOfficialId === item.id}}" class="mini-spinner" />
                <text wx:else>隐藏</text>
              </view>
              <view class="official-inline-action" role="button" data-id="{{item.id}}" catchtap="handleCopyOfficial">复制</view>
              <view
                class="official-topic-action"
                role="button"
                data-id="{{item.id}}"
                catchtap="handleAddOfficial"
              >
                <view wx:if="{{addingOfficialId === item.id}}" class="mini-spinner" />
                <text wx:else>+ 收藏</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{officialTotalPages > 1}}" class="topic-pagination">
        <button
          class="topic-pagination__button"
          disabled="{{officialPage <= 1 || loadingOfficialPage}}"
          data-page="{{officialPage - 1}}"
          bindtap="handleOfficialPageChange"
        >上一页</button>
        <view class="topic-pagination__status">{{officialPage}} / {{officialTotalPages}}</view>
        <button
          class="topic-pagination__button"
          disabled="{{officialPage >= officialTotalPages || loadingOfficialPage}}"
          data-page="{{officialPage + 1}}"
          bindtap="handleOfficialPageChange"
        >下一页</button>
      </view>
    </view>

    <view wx:elif="{{activeTab === 'mine'}}" class="topic-content">
      <view class="section-heading">
        <view>
          <view class="section-heading__title">我的话题</view>
          <view class="section-heading__hint">{{myItems.length}} 个随时可以聊的话题</view>
        </view>
        <view class="section-heading__actions">
          <button wx:if="{{myItems.length}}" class="random-button" bindtap="handleMyRandom">
            <app-icon name="sparkles-white" size="24" />
            <text>随机一组</text>
          </button>
          <button wx:if="{{canWrite}}" class="add-button" bindtap="handleAddMine">
            <app-icon name="plus-white" size="24" />
            <text>新增</text>
          </button>
        </view>
      </view>

      <view wx:if="{{contentLoading}}" class="content-loading">
        <view class="content-loading__spinner" />
        <view class="content-loading__text">正在加载…</view>
      </view>
      <view wx:elif="{{myItems.length === 0}}" class="empty-state">
        <view class="empty-state__title">还没有自己的话题</view>
        <view class="empty-state__hint">从官方话题收藏，或新增一个</view>
      </view>
      <view wx:else class="my-topic-list topic-list">
        <view wx:for="{{myItems}}" wx:key="id" class="my-topic-card">
          <view class="my-topic-card__main">
            <view class="my-topic-card__tag">{{item.official_topic_id ? '官方收录' : '自建'}}</view>
            <view class="my-topic-card__content">{{item.content}}</view>
          </view>
          <view wx:if="{{canWrite}}" class="my-topic-card__actions">
            <view wx:if="{{!item.official_topic_id}}" class="icon-button" role="button" aria-label="编辑话题" data-id="{{item.id}}" bindtap="handleEditMine">
              <app-icon name="pencil" size="24" />
            </view>
            <view class="icon-button" role="button" aria-label="删除话题" data-id="{{item.id}}" bindtap="handleDeleteMine">
              <app-icon name="trash-2-danger" size="24" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="topic-content">
      <view class="section-heading">
        <view>
          <view class="section-heading__title">隐藏列表</view>
          <view class="section-heading__hint">{{hiddenTotal}} 个已隐藏的官方话题</view>
        </view>
      </view>

      <view wx:if="{{loadingHiddenPage && !hiddenHasLoaded}}" class="content-loading">
        <view class="content-loading__spinner" />
        <view class="content-loading__text">正在加载…</view>
      </view>
      <view wx:elif="{{hiddenItems.length === 0}}" class="empty-state">
        <view class="empty-state__title">没有隐藏的话题</view>
        <view class="empty-state__hint">在官方话题中点击“隐藏”后会出现在这里</view>
      </view>
      <view wx:else class="my-topic-list topic-list">
        <view wx:for="{{hiddenItems}}" wx:key="id" class="my-topic-card">
          <view class="my-topic-card__main">
            <view class="my-topic-card__tag">已隐藏</view>
            <view class="my-topic-card__content">{{item.content}}</view>
          </view>
          <view
            class="restore-topic-action"
            role="button"
            data-id="{{item.id}}"
            bindtap="handleRestoreOfficial"
          >
            <view wx:if="{{restoringOfficialId === item.id}}" class="mini-spinner" />
            <text wx:else>恢复</text>
          </view>
        </view>
      </view>
      <view wx:if="{{hiddenTotalPages > 1}}" class="topic-pagination">
        <button
          class="topic-pagination__button"
          disabled="{{hiddenPage <= 1 || loadingHiddenPage}}"
          data-page="{{hiddenPage - 1}}"
          bindtap="handleHiddenPageChange"
        >上一页</button>
        <view class="topic-pagination__status">{{hiddenPage}} / {{hiddenTotalPages}}</view>
        <button
          class="topic-pagination__button"
          disabled="{{hiddenPage >= hiddenTotalPages || loadingHiddenPage}}"
          data-page="{{hiddenPage + 1}}"
          bindtap="handleHiddenPageChange"
        >下一页</button>
      </view>
    </view>
    <view class="scroll-safe-area" />
  </scroll-view>

  <app-dialog
    wx:if="{{showRandomDialog}}"
    visible="{{true}}"
    title="我的话题 · 随机一组"
    custom-body="{{true}}"
    custom-actions="{{true}}"
  >
    <view slot="body" class="random-dialog-list">
      <view wx:for="{{randomDialogItems}}" wx:key="id" class="random-dialog-item">
        <view class="random-dialog-item__number">0{{index + 1}}</view>
        <view class="random-dialog-item__main">
          <view class="random-dialog-item__content">{{item.content}}</view>
          <view class="random-dialog-item__meta">{{item.meta}}</view>
        </view>
      </view>
    </view>
    <view slot="actions" class="dialog-actions">
      <button class="dialog-button dialog-button--cancel" bindtap="closeRandomDialog">关闭</button>
      <button class="dialog-button dialog-button--confirm" bindtap="handleRandomAgain">再随机一次</button>
    </view>
  </app-dialog>

  <app-dialog
    wx:if="{{showOfficialEditor}}"
    visible="{{true}}"
    placement="bottom"
    title="{{editingOfficialId ? '编辑官方话题' : '添加官方话题'}}"
    custom-body="{{true}}"
    custom-actions="{{true}}"
  >
    <view slot="body" class="topic-editor">
      <textarea
        class="topic-editor__input"
        value="{{officialEditorContent}}"
        maxlength="120"
        placeholder="写下一个官方话题…"
        focus
        adjust-position="{{false}}"
        bindinput="handleOfficialEditorInput"
      />
      <view class="topic-editor__count">{{officialEditorContent.length}} / 120</view>
    </view>
    <view slot="actions" class="dialog-actions">
      <button class="dialog-button dialog-button--cancel" disabled="{{officialSaving}}" bindtap="closeOfficialEditor">取消</button>
      <button class="dialog-button dialog-button--confirm" loading="{{officialSaving}}" disabled="{{officialSaving || !officialCanSave}}" bindtap="saveOfficialEditor">{{editingOfficialId ? '保存' : '添加'}}</button>
    </view>
  </app-dialog>

  <app-dialog
    wx:if="{{showEditor}}"
    visible="{{true}}"
    placement="bottom"
    title="{{editorTitle}}"
    custom-body="{{true}}"
    custom-actions="{{true}}"
  >
    <view slot="body" class="topic-editor">
      <textarea
        class="topic-editor__input"
        value="{{editorContent}}"
        maxlength="120"
        placeholder="写下一个想聊的话题…"
        focus
        adjust-position="{{false}}"
        bindinput="handleEditorInput"
      />
      <view class="topic-editor__count">{{editorContent.length}} / 120</view>
    </view>
    <view slot="actions" class="dialog-actions">
      <button class="dialog-button dialog-button--cancel" disabled="{{saving}}" bindtap="closeEditor">取消</button>
      <button class="dialog-button dialog-button--confirm" loading="{{saving}}" disabled="{{saving || !editorCanSave}}" bindtap="saveEditor">保存</button>
    </view>
  </app-dialog>

  <app-dialog
    wx:if="{{showOfficialDeleteConfirm}}"
    visible="{{true}}"
    title="删除官方话题"
    content="删除只影响官方话题库，用户已经收藏的个人话题会继续保留。"
    cancel-text="取消"
    confirm-text="删除"
    bindcancel="handleOfficialDeleteCancel"
    bindconfirm="handleOfficialDeleteConfirm"
  />

  <app-dialog
    wx:if="{{showDeleteConfirm}}"
    visible="{{true}}"
    title="删除话题"
    content="删除后无法恢复，确定删除这个话题吗？"
    cancel-text="取消"
    confirm-text="删除"
    bindcancel="handleDeleteCancel"
    bindconfirm="handleDeleteConfirm"
  />

  <operation-loading visible="{{deleting || officialDeleting}}" text="正在处理…" />
</view>

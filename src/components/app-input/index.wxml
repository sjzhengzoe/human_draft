<view class="app-input__field custom-class">
  <input
    wx:if="{{dialogMode || persistent || editing}}"
    class="app-input__control"
    style="font-family: HumanDraftUI, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: {{fontSize}};"
    always-embed="{{dialogMode ? false : true}}"
    type="{{type}}"
    name="{{name}}"
    value="{{localValue}}"
    maxlength="{{maxlength}}"
    placeholder="{{placeholder}}"
    placeholder-class="app-input__placeholder"
    placeholder-style="font-family: HumanDraftUI, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: {{fontSize}};"
    confirm-type="{{confirmType}}"
    confirm-hold="{{confirmHold}}"
    focus="{{nativeFocus}}"
    adjust-position="{{dialogMode ? false : adjustPosition}}"
    cursor-spacing="{{dialogMode ? 0 : cursorSpacing}}"
    disabled="{{disabled}}"
    bindinput="handleInput"
    bindfocus="handleFocus"
    bindblur="handleBlur"
    bindconfirm="handleConfirm"
  />
  <view
    wx:else
    class="app-input__display {{localValue ? '' : 'app-input__display--placeholder'}} {{disabled ? 'app-input__display--disabled' : ''}}"
    style="font-size: {{fontSize}};"
    role="textbox"
    aria-disabled="{{disabled}}"
    bindtap="handleActivate"
  >{{localValue || placeholder}}</view>
  <view wx:if="{{clearable && localValue && !disabled}}" class="app-input__clear" role="button" aria-label="{{clearAriaLabel}}" catchtap="handleClear"><app-icon name="x-muted" size="24" /></view>
</view>

<app-dialog
  wx:if="{{visible}}"
  visible="{{true}}"
  placement="bottom"
  title="{{title}}"
  custom-body="{{true}}"
  custom-actions="{{true}}"
  bindcancel="handleCancel"
>
  <view slot="body" class="scene-dialog__body">
    <app-input
      custom-class="scene-dialog__input"
      value="{{name}}"
      maxlength="80"
      placeholder="例如：成都三日游"
      focus
      dialog-mode
      disabled="{{saving}}"
      bindinput="handleNameInput"
      bindconfirm="handleConfirm"
    />
  </view>
  <view slot="actions" class="scene-dialog__actions">
    <view
      wx:if="{{deletable}}"
      class="scene-dialog__delete"
      role="button"
      aria-label="删除当前行李场景"
      bindtap="handleDelete"
    >
      <app-icon name="trash-2-danger" size="24" />
      <text>删除场景</text>
    </view>
    <view class="scene-dialog__main-actions">
      <button class="scene-dialog__button" disabled="{{saving}}" bindtap="handleCancel">取消</button>
      <button
        class="scene-dialog__button scene-dialog__button--primary"
        loading="{{saving}}"
        disabled="{{saving || !canSave}}"
        bindtap="handleConfirm"
      >{{confirmText}}</button>
    </view>
  </view>
</app-dialog>

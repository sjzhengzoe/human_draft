<view
  wx:if="{{visible}}"
  class="app-dialog {{fullscreen ? 'app-dialog--fullscreen' : ''}} {{placement === 'bottom' ? 'app-dialog--bottom' : ''}} {{placement === 'bottom' && keyboardHeight ? 'app-dialog--keyboard-open' : ''}}"
  style="{{placement === 'bottom' && keyboardHeight ? 'padding-bottom: ' + keyboardHeight + 'px;' : ''}}"
  catchtouchmove="noop"
  bindtap="handleOverlayTap"
>
  <view class="app-dialog__panel" catchtap="noop">
    <view wx:if="{{placement === 'bottom'}}" class="app-dialog__handle" />
    <view wx:if="{{title}}" class="app-dialog__header">
      <view wx:if="{{title}}" class="app-dialog__title">{{title}}</view>
    </view>
    <view class="app-dialog__body {{title ? '' : 'app-dialog__body--without-title'}} {{customBody ? 'app-dialog__body--custom' : ''}}">
      <slot wx:if="{{customBody}}" name="body" />
      <view wx:else-if="{{content}}" class="app-dialog__content">{{content}}</view>
    </view>
    <view class="app-dialog__actions {{customActions ? 'app-dialog__actions--custom' : ''}}">
      <slot wx:if="{{customActions}}" name="actions" />
      <block wx:else>
        <button class="app-dialog__button app-dialog__button--cancel" bindtap="handleCancel">{{cancelText}}</button>
        <button class="app-dialog__button app-dialog__button--confirm" bindtap="handleConfirm">{{confirmText}}</button>
      </block>
    </view>
  </view>
</view>

<app-dialog
  visible="{{true}}"
  fullscreen="{{true}}"
  custom-body="{{true}}"
  custom-actions="{{true}}"
  bindcancel="handleCancel"
>
  <view slot="body" class="crop-editor">
    <view class="crop-editor__topbar" style="padding-top: {{statusBarHeight}}px;">
      <button
        class="crop-editor__cancel"
        disabled="{{processing}}"
        bindtap="handleCancel"
      >取消</button>
      <view class="crop-editor__title">{{title}}</view>
      <view class="crop-editor__topbar-spacer" />
    </view>

    <view class="crop-workspace">
      <image
        class="crop-image"
        src="{{displaySrc}}"
        mode="scaleToFill"
        style="left: {{imageLeft}}px; top: {{imageTop}}px; width: {{imageWidth}}px; height: {{imageHeight}}px;"
      />

      <view
        wx:if="{{ready}}"
        class="crop-frame crop-frame--{{shape}}"
        style="left: {{cropLeft}}px; top: {{cropTop}}px; width: {{cropWidth}}px; height: {{cropHeight}}px;"
        catchtouchstart="handleFrameTouchStart"
        catchtouchmove="handleGestureMove"
        catchtouchend="handleGestureEnd"
        catchtouchcancel="handleGestureEnd"
      >
        <block wx:if="{{shape !== 'circle'}}">
          <view class="crop-frame__grid crop-frame__grid--vertical crop-frame__grid--vertical-first" />
          <view class="crop-frame__grid crop-frame__grid--vertical crop-frame__grid--vertical-second" />
          <view class="crop-frame__grid crop-frame__grid--horizontal crop-frame__grid--horizontal-first" />
          <view class="crop-frame__grid crop-frame__grid--horizontal crop-frame__grid--horizontal-second" />
        </block>

        <view class="crop-handle crop-handle--nw" data-handle="nw" catchtouchstart="handleResizeTouchStart" catchtouchmove="handleGestureMove" catchtouchend="handleGestureEnd" catchtouchcancel="handleGestureEnd" />
        <view class="crop-handle crop-handle--ne" data-handle="ne" catchtouchstart="handleResizeTouchStart" catchtouchmove="handleGestureMove" catchtouchend="handleGestureEnd" catchtouchcancel="handleGestureEnd" />
        <view class="crop-handle crop-handle--se" data-handle="se" catchtouchstart="handleResizeTouchStart" catchtouchmove="handleGestureMove" catchtouchend="handleGestureEnd" catchtouchcancel="handleGestureEnd" />
        <view class="crop-handle crop-handle--sw" data-handle="sw" catchtouchstart="handleResizeTouchStart" catchtouchmove="handleGestureMove" catchtouchend="handleGestureEnd" catchtouchcancel="handleGestureEnd" />

        <block wx:if="{{!fixedAspectRatio}}">
          <view class="crop-handle crop-handle--n" data-handle="n" catchtouchstart="handleResizeTouchStart" catchtouchmove="handleGestureMove" catchtouchend="handleGestureEnd" catchtouchcancel="handleGestureEnd" />
          <view class="crop-handle crop-handle--e" data-handle="e" catchtouchstart="handleResizeTouchStart" catchtouchmove="handleGestureMove" catchtouchend="handleGestureEnd" catchtouchcancel="handleGestureEnd" />
          <view class="crop-handle crop-handle--s" data-handle="s" catchtouchstart="handleResizeTouchStart" catchtouchmove="handleGestureMove" catchtouchend="handleGestureEnd" catchtouchcancel="handleGestureEnd" />
          <view class="crop-handle crop-handle--w" data-handle="w" catchtouchstart="handleResizeTouchStart" catchtouchmove="handleGestureMove" catchtouchend="handleGestureEnd" catchtouchcancel="handleGestureEnd" />
        </block>
      </view>

      <view wx:if="{{!ready}}" class="crop-loading">正在读取图片…</view>
    </view>
  </view>

  <view slot="actions" class="crop-controls">
    <view class="crop-toolbar">
      <view
        class="crop-toolbar__tool crop-toolbar__tool--active"
        role="button"
        aria-label="裁剪工具，已启用"
      ><app-icon name="crop-white" size="30" /></view>
      <view wx:if="{{!ratioLocked}}" class="crop-toolbar__ratios" aria-label="裁剪比例">
        <view
          wx:for="{{ratioOptions}}"
          wx:key="label"
          class="crop-ratio-option {{activeRatio === item.value ? 'crop-ratio-option--active' : ''}}"
          data-value="{{item.value}}"
          role="button"
          aria-label="裁剪比例 {{item.label}}"
          bindtap="handleRatioOptionTap"
        >{{item.label}}</view>
      </view>
      <view wx:else class="crop-toolbar__fixed-ratio">比例 {{activeRatioLabel}}</view>
      <button
        class="crop-toolbar__done"
        loading="{{processing}}"
        disabled="{{processing || !ready}}"
        bindtap="handleConfirm"
      >完成</button>
    </view>
  </view>
</app-dialog>

<canvas
  type="2d"
  id="imageCropperCanvas"
  class="crop-canvas"
  style="width: 1px; height: 1px;"
/>

<view
  class="template-switch {{disabled ? 'template-switch--disabled' : ''}}"
  role="tablist"
  aria-label="选择图文模板"
  aria-disabled="{{disabled}}"
>
  <view
    wx:for="{{templates}}"
    wx:key="key"
    class="template-switch__item {{activeTemplate === item.key ? 'template-switch__item--active' : ''}}"
    role="tab"
    aria-selected="{{activeTemplate === item.key}}"
    data-template="{{item.key}}"
    bindtap="handleTap"
  >{{item.label}}</view>
</view>

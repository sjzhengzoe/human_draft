<view class="creation-screen {{embedded ? 'creation-screen--embedded' : ''}}">
  <view wx:if="{{!embedded}}" class="creation-navigation">
    <custom-navigation title="图文卡片" />
  </view>

  <view class="page page--{{variant}} {{embedded ? 'page--embedded' : ''}}">
    <view wx:if="{{isExampleContent}}" class="example-notice">
      <text class="example-notice__title">当前是默认文案</text>
      <text class="example-notice__desc">请编辑文案后再导出</text>
    </view>

    <view wx:if="{{!hasCustomContent && !isExampleContent}}" class="card-swiper card-slide">
      <view class="card-item card-item--empty">
        <view class="card-loading card-empty-state">
          <view class="card-empty-state__content">
            <view class="card-loading__title">开始创作</view>
            <view class="card-loading__desc">复制模板，按示例填写内容</view>
            <button class="card-empty-state__copy" bindtap="handleCopyTemplate">
              <text>复制模板</text>
            </button>
          </view>
        </view>
      </view>
    </view>

    <swiper
      wx:else
      class="card-swiper"
      current="{{activeIndex}}"
      indicator-dots="{{renderedImageUrls.length > 1}}"
      indicator-color="{{themeColors.overlaySoft}}"
      indicator-active-color="{{themeColors.actionPrimary}}"
      bindchange="handleSwiperChange"
    >
      <swiper-item wx:for="{{renderedImageUrls}}" wx:key="*this" class="card-slide">
        <view
          class="card-item"
          style="{{fitAdaptiveImages ? imageDisplayStyles[index] : ''}}"
        >
          <image
            class="card-image"
            src="{{item}}"
            mode="widthFix"
            data-index="{{index}}"
            data-url="{{item}}"
            bindload="handleCardImageLoad"
          />
          <view wx:if="{{renderError}}" class="card-preview-overlay">
            <view class="card-preview-overlay__title">{{renderErrorMessage}}</view>
            <button class="card-preview-overlay__retry" bindtap="handleRetryPreview">重新生成</button>
          </view>
          <view wx:elif="{{isRenderingCards && !progressiveRendering}}" class="card-preview-overlay">
            <view class="card-preview-overlay__spinner" />
            <view class="card-preview-overlay__title">{{processingText}}<text wx:if="{{renderProgressText}}"> {{renderProgressText}}</text></view>
          </view>
          <view
            wx:if="{{showCircleImagePicker && !isExampleContent}}"
            class="circle-image-picker {{selectedImagePaths[index] ? 'circle-image-picker--selected' : ''}} {{selectingImage && selectingImageIndex === index ? 'circle-image-picker--loading' : ''}}"
            data-index="{{index}}"
            role="button"
            aria-label="{{selectedImagePaths[index] ? '更换圆形图片' : '添加圆形图片'}}"
            catchtap="handleChooseCircleImage"
          >
            <image
              wx:if="{{selectedImagePaths[index]}}"
              class="circle-image-picker__image"
              src="{{selectedImagePaths[index]}}"
              mode="aspectFill"
            />
            <view wx:else class="circle-image-picker__placeholder">
              <app-icon name="image-plus" size="30" />
            </view>
            <view wx:if="{{selectingImage && selectingImageIndex === index}}" class="circle-image-picker__mask">处理中</view>
          </view>
        </view>
      </swiper-item>

      <swiper-item wx:if="{{!renderedImageUrls.length && renderError}}" class="card-slide">
        <view class="card-item card-item--preview-loading">
          <view class="card-loading">
            <view class="card-loading__title">{{renderErrorMessage}}</view>
            <view class="card-loading__desc">
              {{showCircleImagePicker ? '文案和图片不会丢失，可以重新生成预览' : '文案不会丢失，可以重新生成预览'}}
            </view>
            <button class="card-loading__retry" bindtap="handleRetryPreview">重新生成</button>
          </view>
        </view>
      </swiper-item>

      <swiper-item wx:elif="{{!renderedImageUrls.length}}" class="card-slide">
        <view class="card-item card-item--preview-loading">
          <view class="card-loading">
            <view class="card-loading__title">{{processingText}}<text wx:if="{{renderProgressText}}"> {{renderProgressText}}</text></view>
            <view class="card-loading__desc">完成后可导出高清图片</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="page-count" wx:if="{{contentCount}}">
      <text>预览 · </text>
      <text wx:if="{{mergeStartIndex >= 0 && activeIndex >= mergeStartIndex}}">合并版 · </text>
      {{activeIndex + 1}} / {{previewCount}}
      <text wx:if="{{progressiveRendering && isRenderingCards && renderedImageUrls.length}}"> · 已生成 {{renderedImageUrls.length}} / {{previewCount}}</text>
    </view>

    <text-card-action-bar
      disabled="{{disabled}}"
      has-content="{{hasCustomContent}}"
      export-ready="{{exportReady}}"
      show-append="{{showAppend}}"
      label="{{actionLabel}}"
      bind:action="handleAction"
    />

    <text-card-undo-bar
      visible="{{showClearUndo}}"
      bind:undo="handleUndoClear"
    />
  </view>
</view>
